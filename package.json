{
  "name": "flotilla",
  "displayName": "Flotilla",
  "description": "Run parallel workstreams in git worktrees, across host and devcontainer.",
  "version": "0.0.1",
  "publisher": "archipelagic",
  "license": "MIT",
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "SCM Providers",
    "Other"
  ],
  "extensionKind": [
    "workspace"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "workspaceContains:.git"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "flotilla",
          "title": "Flotilla",
          "icon": "media/flotilla.svg"
        }
      ]
    },
    "views": {
      "flotilla": [
        {
          "type": "webview",
          "id": "flotilla.sidebar",
          "name": "Flotilla"
        }
      ]
    },
    "commands": [
      {
        "command": "flotilla.refresh",
        "title": "Refresh",
        "category": "Flotilla",
        "icon": "$(refresh)"
      },
      {
        "command": "flotilla.newWorkstream",
        "title": "New Workstream…",
        "category": "Flotilla",
        "icon": "$(add)"
      },
      {
        "command": "flotilla.quickSwitch",
        "title": "Switch Workstream…",
        "category": "Flotilla"
      },
      {
        "command": "flotilla.openInNewWindow",
        "title": "Open in New Window",
        "category": "Flotilla",
        "icon": "$(empty-window)"
      },
      {
        "command": "flotilla.switchHere",
        "title": "Switch This Window Here",
        "category": "Flotilla",
        "icon": "$(arrow-swap)"
      },
      {
        "command": "flotilla.remove",
        "title": "Remove Worktree…",
        "category": "Flotilla",
        "icon": "$(trash)"
      },
      {
        "command": "flotilla.adopt",
        "title": "Make Portable (Adopt)",
        "category": "Flotilla"
      },
      {
        "command": "flotilla.runSetupHere",
        "title": "Run Setup Here",
        "category": "Flotilla"
      },
      {
        "command": "flotilla.openTerminal",
        "title": "Open Terminal Here",
        "category": "Flotilla"
      },
      {
        "command": "flotilla.copyPath",
        "title": "Copy Path",
        "category": "Flotilla"
      },
      {
        "command": "flotilla.revealInOS",
        "title": "Reveal in File Explorer",
        "category": "Flotilla"
      },
      {
        "command": "flotilla.compareWith",
        "title": "Compare with…",
        "category": "Flotilla",
        "icon": "$(git-compare)"
      },
      {
        "command": "flotilla.openFileDiff",
        "title": "Open Diff",
        "category": "Flotilla"
      },
      {
        "command": "flotilla.openFile",
        "title": "Open File",
        "category": "Flotilla",
        "icon": "$(go-to-file)"
      },
      {
        "command": "flotilla.clearAgentStatus",
        "title": "Clear Agent Status",
        "category": "Flotilla"
      },
      {
        "command": "flotilla.copyClaudeHookConfig",
        "title": "Copy Claude Code Hook Config",
        "category": "Flotilla"
      },
      {
        "command": "flotilla.commit",
        "title": "Commit…",
        "category": "Flotilla",
        "icon": "$(check)"
      },
      {
        "command": "flotilla.stage",
        "title": "Stage Changes",
        "category": "Flotilla",
        "icon": "$(add)"
      },
      {
        "command": "flotilla.unstage",
        "title": "Unstage Changes",
        "category": "Flotilla",
        "icon": "$(remove)"
      },
      {
        "command": "flotilla.discard",
        "title": "Discard Changes",
        "category": "Flotilla",
        "icon": "$(discard)"
      },
      {
        "command": "flotilla.stageAll",
        "title": "Stage All Changes",
        "category": "Flotilla",
        "icon": "$(add)"
      },
      {
        "command": "flotilla.unstageAll",
        "title": "Unstage All Changes",
        "category": "Flotilla",
        "icon": "$(remove)"
      },
      {
        "command": "flotilla.discardAll",
        "title": "Discard All Changes",
        "category": "Flotilla",
        "icon": "$(discard)"
      },
      {
        "command": "flotilla.publish",
        "title": "Publish Branch",
        "category": "Flotilla",
        "icon": "$(cloud-upload)"
      },
      {
        "command": "flotilla.sync",
        "title": "Sync Changes",
        "category": "Flotilla",
        "icon": "$(sync)"
      },
      {
        "command": "flotilla.push",
        "title": "Push",
        "category": "Flotilla"
      },
      {
        "command": "flotilla.pull",
        "title": "Pull",
        "category": "Flotilla"
      },
      {
        "command": "flotilla.fetch",
        "title": "Fetch",
        "category": "Flotilla"
      },
      {
        "command": "flotilla.addToWorkspace",
        "title": "Add to Workspace",
        "category": "Flotilla",
        "icon": "$(root-folder-opened)"
      },
      {
        "command": "flotilla.removeFromWorkspace",
        "title": "Remove from Workspace",
        "category": "Flotilla",
        "icon": "$(root-folder)"
      },
      {
        "command": "flotilla.revealInExplorer",
        "title": "Reveal in Explorer View",
        "category": "Flotilla",
        "icon": "$(folder-opened)"
      },
      {
        "command": "flotilla.openChanges",
        "title": "Open Changes",
        "category": "Flotilla",
        "icon": "$(diff-multiple)"
      },
      {
        "command": "flotilla.newChat",
        "title": "New Chat",
        "category": "Flotilla",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "flotilla.openChat",
        "title": "Open Chat",
        "category": "Flotilla",
        "icon": "$(link-external)"
      },
      {
        "command": "flotilla.unlinkChat",
        "title": "Unlink Chat from Worktree",
        "category": "Flotilla",
        "icon": "$(close)"
      },
      {
        "command": "flotilla.linkChat",
        "title": "Link a Chat to This Worktree…",
        "category": "Flotilla",
        "icon": "$(link)"
      },
      {
        "command": "flotilla.installClaudeHooks",
        "title": "Install Claude Code Hooks",
        "category": "Flotilla"
      },
      {
        "command": "flotilla.showFiles",
        "title": "Show Files",
        "category": "Flotilla"
      },
      {
        "command": "flotilla.showVersionControl",
        "title": "Show Version Control",
        "category": "Flotilla"
      },
      {
        "command": "flotilla.showChats",
        "title": "Show Chats",
        "category": "Flotilla"
      },
      {
        "command": "flotilla.newFile",
        "title": "New File…",
        "category": "Flotilla",
        "icon": "$(new-file)"
      },
      {
        "command": "flotilla.newFolder",
        "title": "New Folder…",
        "category": "Flotilla",
        "icon": "$(new-folder)"
      },
      {
        "command": "flotilla.renameFile",
        "title": "Rename…",
        "category": "Flotilla"
      },
      {
        "command": "flotilla.deleteFile",
        "title": "Delete",
        "category": "Flotilla"
      },
      {
        "command": "flotilla.copyFile",
        "title": "Copy",
        "category": "Flotilla"
      },
      {
        "command": "flotilla.cutFile",
        "title": "Cut",
        "category": "Flotilla"
      },
      {
        "command": "flotilla.pasteFile",
        "title": "Paste",
        "category": "Flotilla"
      },
      {
        "command": "flotilla.copyRelativePath",
        "title": "Copy Relative Path",
        "category": "Flotilla"
      },
      {
        "command": "flotilla.openToSide",
        "title": "Open to the Side",
        "category": "Flotilla"
      },
      {
        "command": "flotilla.revealFileInOS",
        "title": "Reveal in File Explorer",
        "category": "Flotilla"
      },
      {
        "command": "flotilla.showOverview",
        "title": "Show Overview",
        "category": "Flotilla"
      },
      {
        "command": "flotilla.showSearch",
        "title": "Search in Active Worktree",
        "category": "Flotilla"
      },
      {
        "command": "flotilla.selectWorktree",
        "title": "Switch Active Worktree…",
        "category": "Flotilla"
      },
      {
        "command": "flotilla.newTerminal",
        "title": "New Terminal in Active Worktree",
        "category": "Flotilla"
      },
      {
        "command": "flotilla.configureActivityBar",
        "title": "Use Flotilla as the Sidebar (Activity Bar Position)…",
        "category": "Flotilla"
      },
      {
        "command": "flotilla.quickOpen",
        "title": "Go to File in Active Worktree…",
        "category": "Flotilla"
      },
      {
        "command": "flotilla.showSidebar",
        "title": "Show Flotilla",
        "category": "Flotilla"
      },
      {
        "command": "flotilla.closeTab",
        "title": "Close Tab",
        "category": "Flotilla",
        "icon": "$(close)"
      },
      {
        "command": "flotilla.closeOtherTabs",
        "title": "Close Other Tabs",
        "category": "Flotilla"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "flotilla.refresh",
          "when": "flotilla.state == ready"
        },
        {
          "command": "flotilla.newWorkstream",
          "when": "flotilla.state == ready"
        },
        {
          "command": "flotilla.quickSwitch",
          "when": "flotilla.state == ready"
        },
        {
          "command": "flotilla.openInNewWindow",
          "when": "flotilla.state == ready"
        },
        {
          "command": "flotilla.switchHere",
          "when": "flotilla.state == ready"
        },
        {
          "command": "flotilla.remove",
          "when": "flotilla.state == ready"
        },
        {
          "command": "flotilla.adopt",
          "when": "flotilla.state == ready"
        },
        {
          "command": "flotilla.runSetupHere",
          "when": "flotilla.state == ready"
        },
        {
          "command": "flotilla.openTerminal",
          "when": "flotilla.state == ready"
        },
        {
          "command": "flotilla.copyPath",
          "when": "flotilla.state == ready"
        },
        {
          "command": "flotilla.revealInOS",
          "when": "flotilla.state == ready && !remoteName"
        },
        {
          "command": "flotilla.compareWith",
          "when": "flotilla.state == ready"
        },
        {
          "command": "flotilla.clearAgentStatus",
          "when": "flotilla.state == ready"
        },
        {
          "command": "flotilla.copyClaudeHookConfig",
          "when": "flotilla.state == ready"
        },
        {
          "command": "flotilla.openFileDiff",
          "when": "false"
        },
        {
          "command": "flotilla.openFile",
          "when": "false"
        },
        {
          "command": "flotilla.commit",
          "when": "flotilla.state == ready"
        },
        {
          "command": "flotilla.stageAll",
          "when": "flotilla.state == ready"
        },
        {
          "command": "flotilla.unstageAll",
          "when": "flotilla.state == ready"
        },
        {
          "command": "flotilla.discardAll",
          "when": "flotilla.state == ready"
        },
        {
          "command": "flotilla.publish",
          "when": "flotilla.state == ready"
        },
        {
          "command": "flotilla.sync",
          "when": "flotilla.state == ready"
        },
        {
          "command": "flotilla.push",
          "when": "flotilla.state == ready"
        },
        {
          "command": "flotilla.pull",
          "when": "flotilla.state == ready"
        },
        {
          "command": "flotilla.fetch",
          "when": "flotilla.state == ready"
        },
        {
          "command": "flotilla.addToWorkspace",
          "when": "flotilla.state == ready"
        },
        {
          "command": "flotilla.removeFromWorkspace",
          "when": "flotilla.state == ready"
        },
        {
          "command": "flotilla.revealInExplorer",
          "when": "flotilla.state == ready"
        },
        {
          "command": "flotilla.stage",
          "when": "false"
        },
        {
          "command": "flotilla.unstage",
          "when": "false"
        },
        {
          "command": "flotilla.discard",
          "when": "false"
        },
        {
          "command": "flotilla.newChat",
          "when": "flotilla.state == ready"
        },
        {
          "command": "flotilla.linkChat",
          "when": "flotilla.state == ready"
        },
        {
          "command": "flotilla.installClaudeHooks",
          "when": "flotilla.state == ready"
        },
        {
          "command": "flotilla.openChanges",
          "when": "false"
        },
        {
          "command": "flotilla.openChat",
          "when": "false"
        },
        {
          "command": "flotilla.unlinkChat",
          "when": "false"
        },
        {
          "command": "flotilla.showFiles",
          "when": "flotilla.state == ready"
        },
        {
          "command": "flotilla.showVersionControl",
          "when": "flotilla.state == ready"
        },
        {
          "command": "flotilla.showChats",
          "when": "flotilla.state == ready"
        },
        {
          "command": "flotilla.newFile",
          "when": "false"
        },
        {
          "command": "flotilla.newFolder",
          "when": "false"
        },
        {
          "command": "flotilla.renameFile",
          "when": "false"
        },
        {
          "command": "flotilla.deleteFile",
          "when": "false"
        },
        {
          "command": "flotilla.copyFile",
          "when": "false"
        },
        {
          "command": "flotilla.cutFile",
          "when": "false"
        },
        {
          "command": "flotilla.pasteFile",
          "when": "false"
        },
        {
          "command": "flotilla.copyRelativePath",
          "when": "false"
        },
        {
          "command": "flotilla.openToSide",
          "when": "false"
        },
        {
          "command": "flotilla.revealFileInOS",
          "when": "false"
        },
        {
          "command": "flotilla.showOverview",
          "when": "flotilla.state == ready"
        },
        {
          "command": "flotilla.showSearch",
          "when": "flotilla.state == ready"
        },
        {
          "command": "flotilla.selectWorktree",
          "when": "flotilla.state == ready"
        },
        {
          "command": "flotilla.newTerminal",
          "when": "flotilla.state == ready"
        },
        {
          "command": "flotilla.configureActivityBar",
          "when": "flotilla.state == ready"
        },
        {
          "command": "flotilla.quickOpen",
          "when": "flotilla.state == ready"
        },
        {
          "command": "flotilla.showSidebar",
          "when": "flotilla.state == ready"
        },
        {
          "command": "flotilla.closeTab",
          "when": "flotilla.state == ready && flotilla.activeWorktree != 'all'"
        },
        {
          "command": "flotilla.closeOtherTabs",
          "when": "flotilla.state == ready && flotilla.activeWorktree != 'all'"
        }
      ],
      "view/title": [
        {
          "command": "flotilla.newWorkstream",
          "when": "view == flotilla.sidebar && flotilla.state == ready",
          "group": "navigation@1"
        },
        {
          "command": "flotilla.refresh",
          "when": "view == flotilla.sidebar && flotilla.state == ready",
          "group": "navigation@2"
        },
        {
          "command": "flotilla.copyClaudeHookConfig",
          "when": "view == flotilla.sidebar && flotilla.state == ready",
          "group": "1_agents@1"
        },
        {
          "command": "flotilla.installClaudeHooks",
          "when": "view == flotilla.sidebar && flotilla.state == ready",
          "group": "1_agents@0"
        }
      ],
      "explorer/context": [
        {
          "submenu": "flotilla.explorer",
          "when": "explorerResourceIsFolder && resourcePath in flotilla.worktreeFolders",
          "group": "7_flotilla@1"
        }
      ],
      "flotilla.explorer": [
        {
          "command": "flotilla.openInNewWindow",
          "group": "1_open@1"
        },
        {
          "command": "flotilla.switchHere",
          "group": "1_open@2"
        },
        {
          "command": "flotilla.addToWorkspace",
          "when": "!(resourcePath in flotilla.workspaceWorktrees)",
          "group": "2_workspace@1"
        },
        {
          "command": "flotilla.removeFromWorkspace",
          "when": "resourcePath in flotilla.workspaceWorktrees",
          "group": "2_workspace@1"
        },
        {
          "command": "flotilla.commit",
          "group": "3_scm@1"
        },
        {
          "command": "flotilla.sync",
          "group": "3_scm@2"
        },
        {
          "command": "flotilla.compareWith",
          "group": "4_compare@1"
        },
        {
          "command": "flotilla.openTerminal",
          "group": "5_tools@1"
        },
        {
          "command": "flotilla.remove",
          "group": "9_remove@1"
        }
      ],
      "webview/context": [
        {
          "command": "flotilla.openInNewWindow",
          "when": "webviewId == 'flotilla.sidebar' && webviewSection == 'workstream' && flotillaWs =~ /;reachable;notCurrent;/",
          "group": "1_open@1"
        },
        {
          "command": "flotilla.switchHere",
          "when": "webviewId == 'flotilla.sidebar' && webviewSection == 'workstream' && flotillaWs =~ /;reachable;notCurrent;/",
          "group": "1_open@2"
        },
        {
          "command": "flotilla.addToWorkspace",
          "when": "webviewId == 'flotilla.sidebar' && webviewSection == 'workstream' && flotillaWs =~ /;reachable;notCurrent;linked;.*;notInWorkspace;/",
          "group": "1_open@3"
        },
        {
          "command": "flotilla.removeFromWorkspace",
          "when": "webviewId == 'flotilla.sidebar' && webviewSection == 'workstream' && flotillaWs =~ /;inWorkspace;/",
          "group": "1_open@3"
        },
        {
          "command": "flotilla.revealInExplorer",
          "when": "webviewId == 'flotilla.sidebar' && webviewSection == 'workstream' && flotillaWs =~ /;reachable;/",
          "group": "1_open@4"
        },
        {
          "command": "flotilla.newChat",
          "when": "webviewId == 'flotilla.sidebar' && webviewSection == 'workstream' && flotillaWs =~ /;reachable;/",
          "group": "2_chat@1"
        },
        {
          "command": "flotilla.linkChat",
          "when": "webviewId == 'flotilla.sidebar' && webviewSection == 'workstream' && flotillaWs =~ /;reachable;/",
          "group": "2_chat@2"
        },
        {
          "command": "flotilla.commit",
          "when": "webviewId == 'flotilla.sidebar' && webviewSection == 'workstream' && flotillaWs =~ /;reachable;/",
          "group": "3_scm@1"
        },
        {
          "command": "flotilla.publish",
          "when": "webviewId == 'flotilla.sidebar' && webviewSection == 'workstream' && flotillaWs =~ /;publishable;/",
          "group": "3_scm@2"
        },
        {
          "command": "flotilla.sync",
          "when": "webviewId == 'flotilla.sidebar' && webviewSection == 'workstream' && flotillaWs =~ /;tracking;/",
          "group": "3_scm@3"
        },
        {
          "command": "flotilla.pull",
          "when": "webviewId == 'flotilla.sidebar' && webviewSection == 'workstream' && flotillaWs =~ /;tracking;/",
          "group": "3_scm@4"
        },
        {
          "command": "flotilla.push",
          "when": "webviewId == 'flotilla.sidebar' && webviewSection == 'workstream' && flotillaWs =~ /;tracking;/",
          "group": "3_scm@5"
        },
        {
          "command": "flotilla.fetch",
          "when": "webviewId == 'flotilla.sidebar' && webviewSection == 'workstream' && flotillaWs =~ /;reachable;/",
          "group": "3_scm@6"
        },
        {
          "command": "flotilla.compareWith",
          "when": "webviewId == 'flotilla.sidebar' && webviewSection == 'workstream' && flotillaWs =~ /;reachable;/",
          "group": "4_compare@1"
        },
        {
          "command": "flotilla.openTerminal",
          "when": "webviewId == 'flotilla.sidebar' && webviewSection == 'workstream' && flotillaWs =~ /;reachable;/",
          "group": "5_tools@1"
        },
        {
          "command": "flotilla.copyPath",
          "when": "webviewId == 'flotilla.sidebar' && webviewSection == 'workstream' && flotillaWs =~ /;reachable;/",
          "group": "5_tools@2"
        },
        {
          "command": "flotilla.revealInOS",
          "when": "webviewId == 'flotilla.sidebar' && webviewSection == 'workstream' && flotillaWs =~ /;reachable;/ && !remoteName",
          "group": "5_tools@3"
        },
        {
          "command": "flotilla.runSetupHere",
          "when": "webviewId == 'flotilla.sidebar' && webviewSection == 'workstream' && flotillaWs =~ /;reachable;.*;linked;/",
          "group": "6_setup@1"
        },
        {
          "command": "flotilla.adopt",
          "when": "webviewId == 'flotilla.sidebar' && webviewSection == 'workstream' && flotillaWs =~ /;reachable;.*;linked;notPortable;/",
          "group": "6_setup@2"
        },
        {
          "command": "flotilla.installClaudeHooks",
          "when": "webviewId == 'flotilla.sidebar' && webviewSection == 'workstream' && flotillaWs =~ /;reachable;/",
          "group": "6_setup@3"
        },
        {
          "command": "flotilla.clearAgentStatus",
          "when": "webviewId == 'flotilla.sidebar' && webviewSection == 'workstream' && flotillaWs =~ /;hasAgent;/",
          "group": "7_agent@1"
        },
        {
          "command": "flotilla.remove",
          "when": "webviewId == 'flotilla.sidebar' && webviewSection == 'workstream' && flotillaWs =~ /;linked;/",
          "group": "9_remove@1"
        },
        {
          "command": "flotilla.openChanges",
          "when": "webviewId == 'flotilla.sidebar' && webviewSection == 'changeGroup'",
          "group": "1_open@1"
        },
        {
          "command": "flotilla.stageAll",
          "when": "webviewId == 'flotilla.sidebar' && webviewSection == 'changeGroup' && group == 'unstaged'",
          "group": "2_scm@1"
        },
        {
          "command": "flotilla.discardAll",
          "when": "webviewId == 'flotilla.sidebar' && webviewSection == 'changeGroup' && group == 'unstaged'",
          "group": "2_scm@2"
        },
        {
          "command": "flotilla.unstageAll",
          "when": "webviewId == 'flotilla.sidebar' && webviewSection == 'changeGroup' && group == 'staged'",
          "group": "2_scm@1"
        },
        {
          "command": "flotilla.openFileDiff",
          "when": "webviewId == 'flotilla.sidebar' && webviewSection == 'change'",
          "group": "1_open@1"
        },
        {
