{
  "name": "flotilla",
  "displayName": "Flotilla",
  "description": "Run parallel workstreams in git worktrees, across host and devcontainer.",
  "version": "0.0.1",
  "publisher": "archipelagic",
  "license": "MIT",
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "SCM Providers",
    "Other"
  ],
  "extensionKind": [
    "workspace"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "workspaceContains:.git"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "flotilla",
          "title": "Flotilla",
          "icon": "media/flotilla.svg"
        }
      ]
    },
    "views": {
      "flotilla": [
        {
          "id": "flotilla.workstreams",
          "name": "Workstreams"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "flotilla.workstreams",
        "contents": "Flotilla needs git 2.17 or newer in this environment.\n[Download git](https://git-scm.com/downloads)",
        "when": "flotilla.state == gitMissing"
      },
      {
        "view": "flotilla.workstreams",
        "contents": "Open a folder inside a git repository to manage workstreams.",
        "when": "flotilla.state == noRepo"
      }
    ],
    "commands": [
      {
        "command": "flotilla.refresh",
        "title": "Refresh",
        "category": "Flotilla",
        "icon": "$(refresh)"
      },
      {
        "command": "flotilla.newWorkstream",
        "title": "New Workstream…",
        "category": "Flotilla",
        "icon": "$(add)"
      },
      {
        "command": "flotilla.quickSwitch",
        "title": "Switch Workstream…",
        "category": "Flotilla"
      },
      {
        "command": "flotilla.openInNewWindow",
        "title": "Open in New Window",
        "category": "Flotilla",
        "icon": "$(empty-window)"
      },
      {
        "command": "flotilla.switchHere",
        "title": "Switch This Window Here",
        "category": "Flotilla",
        "icon": "$(arrow-swap)"
      },
      {
        "command": "flotilla.remove",
        "title": "Remove Worktree…",
        "category": "Flotilla",
        "icon": "$(trash)"
      },
      {
        "command": "flotilla.adopt",
        "title": "Make Portable (Adopt)",
        "category": "Flotilla"
      },
      {
        "command": "flotilla.runSetupHere",
        "title": "Run Setup Here",
        "category": "Flotilla"
      },
      {
        "command": "flotilla.openTerminal",
        "title": "Open Terminal Here",
        "category": "Flotilla"
      },
      {
        "command": "flotilla.copyPath",
        "title": "Copy Path",
        "category": "Flotilla"
      },
      {
        "command": "flotilla.revealInOS",
        "title": "Reveal in File Explorer",
        "category": "Flotilla"
      },
      {
        "command": "flotilla.compareWith",
        "title": "Compare with…",
        "category": "Flotilla",
        "icon": "$(git-compare)"
      },
      {
        "command": "flotilla.compareToggleTwoDot",
        "title": "Toggle Two-Dot Compare",
        "category": "Flotilla",
        "icon": "$(arrow-both)"
      },
      {
        "command": "flotilla.compareToggleUncommitted",
        "title": "Toggle Include Uncommitted",
        "category": "Flotilla",
        "icon": "$(edit)"
      },
      {
        "command": "flotilla.compareDismiss",
        "title": "Dismiss Compare",
        "category": "Flotilla",
        "icon": "$(close)"
      },
      {
        "command": "flotilla.openFileDiff",
        "title": "Open Diff",
        "category": "Flotilla"
      },
      {
        "command": "flotilla.openFile",
        "title": "Open File",
        "category": "Flotilla",
        "icon": "$(go-to-file)"
      },
      {
        "command": "flotilla.clearAgentStatus",
        "title": "Clear Agent Status",
        "category": "Flotilla"
      },
      {
        "command": "flotilla.copyClaudeHookConfig",
        "title": "Copy Claude Code Hook Config",
        "category": "Flotilla"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "flotilla.refresh",
          "when": "flotilla.state == ready"
        },
        {
          "command": "flotilla.newWorkstream",
          "when": "flotilla.state == ready"
        },
        {
          "command": "flotilla.quickSwitch",
          "when": "flotilla.state == ready"
        },
        {
          "command": "flotilla.openInNewWindow",
          "when": "flotilla.state == ready"
        },
        {
          "command": "flotilla.switchHere",
          "when": "flotilla.state == ready"
        },
        {
          "command": "flotilla.remove",
          "when": "flotilla.state == ready"
        },
        {
          "command": "flotilla.adopt",
          "when": "flotilla.state == ready"
        },
        {
          "command": "flotilla.runSetupHere",
          "when": "flotilla.state == ready"
        },
        {
          "command": "flotilla.openTerminal",
          "when": "flotilla.state == ready"
        },
        {
          "command": "flotilla.copyPath",
          "when": "flotilla.state == ready"
        },
        {
          "command": "flotilla.revealInOS",
          "when": "flotilla.state == ready && !remoteName"
        },
        {
          "command": "flotilla.compareWith",
          "when": "flotilla.state == ready"
        },
        {
          "command": "flotilla.clearAgentStatus",
          "when": "flotilla.state == ready"
        },
        {
        "command": "flotilla.copyClaudeHookConfig",
        "when": "flotilla.state == ready"
      },
        {
          "command": "flotilla.compareToggleTwoDot",
          "when": "false"
        },
        {
          "command": "flotilla.compareToggleUncommitted",
          "when": "false"
        },
        {
          "command": "flotilla.compareDismiss",
          "when": "false"
        },
        {
          "command": "flotilla.openFileDiff",
          "when": "false"
        },
        {
          "command": "flotilla.openFile",
          "when": "false"
        }
      ],
      "view/title": [
        {
          "command": "flotilla.newWorkstream",
          "when": "view == flotilla.workstreams && flotilla.state == ready",
          "group": "navigation@1"
        },
        {
          "command": "flotilla.refresh",
          "when": "view == flotilla.workstreams && flotilla.state == ready",
          "group": "navigation@2"
        },
        {
          "command": "flotilla.copyClaudeHookConfig",
          "when": "view == flotilla.workstreams && flotilla.state == ready",
          "group": "1_agents@1"
        }
      ],
      "view/item/context": [
        {
          "command": "flotilla.openInNewWindow",
          "when": "view == flotilla.workstreams && viewItem =~ /;reachable;notCurrent;/",
          "group": "inline@1"
        },
        {
          "command": "flotilla.switchHere",
          "when": "view == flotilla.workstreams && viewItem =~ /;reachable;notCurrent;/",
          "group": "inline@2"
        },
        {
          "command": "flotilla.remove",
          "when": "view == flotilla.workstreams && viewItem =~ /;linked;/",
          "group": "inline@3"
        },
        {
          "command": "flotilla.openInNewWindow",
          "when": "view == flotilla.workstreams && viewItem =~ /;reachable;notCurrent;/",
          "group": "1_open@1"
        },
        {
          "command": "flotilla.switchHere",
          "when": "view == flotilla.workstreams && viewItem =~ /;reachable;notCurrent;/",
          "group": "1_open@2"
        },
        {
          "command": "flotilla.compareWith",
          "when": "view == flotilla.workstreams && viewItem =~ /;reachable;/",
          "group": "2_compare@1"
        },
        {
          "command": "flotilla.openTerminal",
          "when": "view == flotilla.workstreams && viewItem =~ /;reachable;/",
          "group": "3_tools@1"
        },
        {
          "command": "flotilla.copyPath",
          "when": "view == flotilla.workstreams && viewItem =~ /;reachable;/",
          "group": "3_tools@2"
        },
        {
          "command": "flotilla.revealInOS",
          "when": "view == flotilla.workstreams && viewItem =~ /;reachable;/ && !remoteName",
          "group": "3_tools@3"
        },
        {
          "command": "flotilla.runSetupHere",
          "when": "view == flotilla.workstreams && viewItem =~ /;reachable;.*;linked;/",
          "group": "4_setup@1"
        },
        {
          "command": "flotilla.adopt",
          "when": "view == flotilla.workstreams && viewItem =~ /;reachable;.*;linked;notPortable;/",
          "group": "4_setup@2"
        },
        {
          "command": "flotilla.clearAgentStatus",
          "when": "view == flotilla.workstreams && viewItem =~ /;hasAgent;/",
          "group": "5_agent@1"
        },
        {
          "command": "flotilla.remove",
          "when": "view == flotilla.workstreams && viewItem =~ /;linked;/",
          "group": "9_remove@1"
        },
        {
          "command": "flotilla.compareToggleTwoDot",
          "when": "view == flotilla.workstreams && viewItem == compare",
          "group": "inline@1"
        },
        {
          "command": "flotilla.compareToggleUncommitted",
          "when": "view == flotilla.workstreams && viewItem == compare",
          "group": "inline@2"
        },
        {
          "command": "flotilla.compareDismiss",
          "when": "view == flotilla.workstreams && viewItem == compare",
          "group": "inline@3"
        },
        {
          "command": "flotilla.openFile",
          "when": "view == flotilla.workstreams && viewItem == file",
          "group": "inline@1"
        }
      ]
    },
    "configuration": {
      "title": "Flotilla",
      "properties": {
        "flotilla.openAfterCreate": {
          "type": "string",
          "enum": [
            "newWindow",
            "currentWindow",
            "none"
          ],
          "enumDescriptions": [
            "Open the new worktree in a new window",
            "Switch this window to the new worktree",
            "Stay where you are"
          ],
          "default": "newWindow",
          "description": "What to do after creating a workstream."
        },
        "flotilla.copyFiles": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Glob patterns (relative to the main worktree) of ignored files to copy into new worktrees, e.g. \".env\"."
        },
        "flotilla.setupCommand": {
          "type": "string",
          "default": "",
          "description": "Command to run in a terminal in a new worktree, e.g. \"npm ci\"."
        },
        "flotilla.autoAdopt": {
          "type": "boolean",
          "default": true,
          "description": "Automatically make worktrees inside the repository portable across host and container."
        },
        "flotilla.defaultBase": {
          "type": "string",
          "default": "",
          "description": "Base branch for progress and comparisons. Empty: origin/HEAD, then main, then master."
        },
        "flotilla.activeWindowMinutes": {
          "type": "number",
          "default": 5,
          "minimum": 1,
          "description": "A workstream with changes newer than this is 'active'."
        },
        "flotilla.staleAfterDays": {
          "type": "number",
          "default": 7,
          "minimum": 1,
          "description": "A workstream with no activity for this long is 'stale'."
        },
        "flotilla.agentStatusStaleMinutes": {
          "type": "number",
          "default": 10,
          "minimum": 1,
          "description": "A 'working' agent report older than this is shown as last reported."
        },
        "flotilla.notifyOnAttention": {
          "type": "boolean",
          "default": true,
          "description": "Notify when a workstream starts waiting for input or reports an error."
        },
        "flotilla.pollSeconds": {
          "type": "number",
          "default": 15,
          "minimum": 5,
          "description": "How often to refresh while the Workstreams view is visible."
        }
      }
    }
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:vscode": "npm run build && node tests/vscode/prepareFixture.mjs && tsc -p tsconfig.vscode-test.json && vscode-test",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.20.5",
    "@types/vscode": "^1.95.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "tinyglobby": "^0.2.17"
  }
}
