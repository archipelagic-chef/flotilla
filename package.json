        },
        {
          "command": "flotilla.discard",
          "when": "webviewId == 'flotilla.sidebar' && webviewSection == 'change' && discardable",
          "group": "2_scm@2"
        },
        {
          "command": "flotilla.unstage",
          "when": "webviewId == 'flotilla.sidebar' && webviewSection == 'change' && group == 'staged'",
          "group": "2_scm@1"
        },
        {
          "command": "flotilla.openChat",
          "when": "webviewId == 'flotilla.sidebar' && webviewSection == 'chat'",
          "group": "1_open@1"
        },
        {
          "command": "flotilla.unlinkChat",
          "when": "webviewId == 'flotilla.sidebar' && webviewSection == 'chat'",
          "group": "2_link@1"
        },
        {
          "command": "flotilla.openFile",
          "when": "webviewId == 'flotilla.sidebar' && webviewSection == 'file'",
          "group": "1_open@1"
        },
        {
          "command": "flotilla.openToSide",
          "when": "webviewId == 'flotilla.sidebar' && webviewSection == 'file'",
          "group": "1_open@2"
        },
        {
          "command": "flotilla.newFile",
          "when": "webviewId == 'flotilla.sidebar' && webviewSection == 'file'",
          "group": "2_new@1"
        },
        {
          "command": "flotilla.newFolder",
          "when": "webviewId == 'flotilla.sidebar' && webviewSection == 'file'",
          "group": "2_new@2"
        },
        {
          "command": "flotilla.revealInExplorer",
          "when": "webviewId == 'flotilla.sidebar' && webviewSection == 'file'",
          "group": "3_reveal@1"
        },
        {
          "command": "flotilla.revealFileInOS",
          "when": "webviewId == 'flotilla.sidebar' && webviewSection == 'file' && !remoteName",
          "group": "3_reveal@2"
        },
        {
          "command": "flotilla.cutFile",
          "when": "webviewId == 'flotilla.sidebar' && webviewSection == 'file'",
          "group": "5_cutcopypaste@1"
        },
        {
          "command": "flotilla.copyFile",
          "when": "webviewId == 'flotilla.sidebar' && webviewSection == 'file'",
          "group": "5_cutcopypaste@2"
        },
        {
          "command": "flotilla.pasteFile",
          "when": "webviewId == 'flotilla.sidebar' && webviewSection == 'file' && flotilla.canPaste",
          "group": "5_cutcopypaste@3"
        },
        {
          "command": "flotilla.copyPath",
          "when": "webviewId == 'flotilla.sidebar' && webviewSection == 'file'",
          "group": "6_copypath@1"
        },
        {
          "command": "flotilla.copyRelativePath",
          "when": "webviewId == 'flotilla.sidebar' && webviewSection == 'file'",
          "group": "6_copypath@2"
        },
        {
          "command": "flotilla.renameFile",
          "when": "webviewId == 'flotilla.sidebar' && webviewSection == 'file'",
          "group": "7_modification@1"
        },
        {
          "command": "flotilla.deleteFile",
          "when": "webviewId == 'flotilla.sidebar' && webviewSection == 'file'",
          "group": "7_modification@2"
        },
        {
          "command": "flotilla.newFile",
          "when": "webviewId == 'flotilla.sidebar' && webviewSection == 'folder'",
          "group": "2_new@1"
        },
        {
          "command": "flotilla.newFolder",
          "when": "webviewId == 'flotilla.sidebar' && webviewSection == 'folder'",
          "group": "2_new@2"
        },
        {
          "command": "flotilla.revealInExplorer",
          "when": "webviewId == 'flotilla.sidebar' && webviewSection == 'folder'",
          "group": "3_reveal@1"
        },
        {
          "command": "flotilla.revealFileInOS",
          "when": "webviewId == 'flotilla.sidebar' && webviewSection == 'folder' && !remoteName",
          "group": "3_reveal@2"
        },
        {
          "command": "flotilla.cutFile",
          "when": "webviewId == 'flotilla.sidebar' && webviewSection == 'folder'",
          "group": "5_cutcopypaste@1"
        },
        {
          "command": "flotilla.copyFile",
          "when": "webviewId == 'flotilla.sidebar' && webviewSection == 'folder'",
          "group": "5_cutcopypaste@2"
        },
        {
          "command": "flotilla.pasteFile",
          "when": "webviewId == 'flotilla.sidebar' && webviewSection == 'folder' && flotilla.canPaste",
          "group": "5_cutcopypaste@3"
        },
        {
          "command": "flotilla.copyPath",
          "when": "webviewId == 'flotilla.sidebar' && webviewSection == 'folder'",
          "group": "6_copypath@1"
        },
        {
          "command": "flotilla.copyRelativePath",
          "when": "webviewId == 'flotilla.sidebar' && webviewSection == 'folder'",
          "group": "6_copypath@2"
        },
        {
          "command": "flotilla.renameFile",
          "when": "webviewId == 'flotilla.sidebar' && webviewSection == 'folder'",
          "group": "7_modification@1"
        },
        {
          "command": "flotilla.deleteFile",
          "when": "webviewId == 'flotilla.sidebar' && webviewSection == 'folder'",
          "group": "7_modification@2"
        },
        {
          "command": "flotilla.newFile",
          "when": "webviewId == 'flotilla.sidebar' && webviewSection == 'workstream' && flotillaTab == 'files' && flotillaWs =~ /;reachable;/",
          "group": "0_files@1"
        },
        {
          "command": "flotilla.newFolder",
          "when": "webviewId == 'flotilla.sidebar' && webviewSection == 'workstream' && flotillaTab == 'files' && flotillaWs =~ /;reachable;/",
          "group": "0_files@2"
        },
        {
          "command": "flotilla.pasteFile",
          "when": "webviewId == 'flotilla.sidebar' && webviewSection == 'workstream' && flotillaTab == 'files' && flotilla.canPaste",
          "group": "0_files@3"
        },
        {
          "command": "flotilla.closeTab",
          "when": "webviewId == 'flotilla.sidebar' && webviewSection == 'workstream' && flotillaTabItem",
          "group": "0_tab@1"
        },
        {
          "command": "flotilla.closeOtherTabs",
          "when": "webviewId == 'flotilla.sidebar' && webviewSection == 'workstream' && flotillaTabItem",
          "group": "0_tab@2"
        }
      ]
    },
    "configuration": {
      "title": "Flotilla",
      "properties": {
        "flotilla.copyFiles": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Glob patterns (relative to the main worktree) of ignored files to copy into new worktrees, e.g. \".env\"."
        },
        "flotilla.setupCommand": {
          "type": "string",
          "default": "",
          "description": "Command to run in a terminal in a new worktree, e.g. \"npm ci\"."
        },
        "flotilla.autoAdopt": {
          "type": "boolean",
          "default": true,
          "description": "Automatically make worktrees inside the repository portable across host and container."
        },
        "flotilla.defaultBase": {
          "type": "string",
          "default": "",
          "description": "Base branch for progress and comparisons. Empty: origin/HEAD, then main, then master."
        },
        "flotilla.activeWindowMinutes": {
          "type": "number",
          "default": 5,
          "minimum": 1,
          "description": "A workstream with changes newer than this is 'active'."
        },
        "flotilla.staleAfterDays": {
          "type": "number",
          "default": 7,
          "minimum": 1,
          "description": "A workstream with no activity for this long is 'stale'."
        },
        "flotilla.agentStatusStaleMinutes": {
          "type": "number",
          "default": 10,
          "minimum": 1,
          "description": "A 'working' agent report older than this is shown as last reported."
        },
        "flotilla.notifyOnAttention": {
          "type": "boolean",
          "default": true,
          "description": "Notify when a workstream starts waiting for input or reports an error."
        },
        "flotilla.pollSeconds": {
          "type": "number",
          "default": 15,
          "minimum": 5,
          "description": "How often to refresh while the Workstreams view is visible."
        },
        "flotilla.tagChatTitles": {
          "type": "boolean",
          "default": true,
          "description": "Show the worktree in Claude Code's own session list: chats linked to a worktree are renamed to \"<branch>: <title>\" once Claude Code has titled them. A title you set yourself is never replaced."
        },
        "flotilla.search.maxResults": {
          "type": "number",
          "default": 2000,
          "minimum": 100,
          "description": "Search results per worktree before Flotilla asks you to refine the search or show more."
        },
        "flotilla.tabLabelPattern": {
          "type": "string",
          "default": "",
          "markdownDescription": "Regular expression that finds the id to show on a worktree tab (its first group, or the whole match), e.g. `T\\d+`. Empty: a Jira key such as `ABC-123`, or an issue number at the start of a branch part (`123-fix` → `#123`); otherwise the last part of the branch."
        }
      }
    },
    "submenus": [
      {
        "id": "flotilla.explorer",
        "label": "Flotilla"
      }
    ],
    "keybindings": [
      {
        "command": "flotilla.selectWorktree",
