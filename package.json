      },
      {
        "command": "flotilla.showSearch",
        "key": "ctrl+alt+f",
        "when": "flotilla.state == ready"
      },
      {
        "command": "flotilla.quickOpen",
        "key": "ctrl+p",
        "mac": "cmd+p",
        "when": "flotilla.state == ready && flotilla.activeWorktree != 'all'"
      },
      {
        "command": "flotilla.showFiles",
        "key": "ctrl+shift+e",
        "mac": "cmd+shift+e",
        "when": "flotilla.state == ready && config.workbench.activityBar.location == 'hidden'"
      },
      {
        "command": "flotilla.showSearch",
        "key": "ctrl+shift+f",
        "mac": "cmd+shift+f",
        "when": "flotilla.state == ready && config.workbench.activityBar.location == 'hidden'"
      },
      {
        "command": "flotilla.showVersionControl",
        "key": "ctrl+shift+g",
        "mac": "ctrl+shift+g",
        "when": "flotilla.state == ready && config.workbench.activityBar.location == 'hidden'"
      }
    ]
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.webview.json",
    "test": "vitest run",
    "test:vscode": "npm run build && node tests/vscode/prepareFixture.mjs && tsc -p tsconfig.vscode-test.json && vscode-test",
    "package": "vsce package",
    "playground": "node scripts/playground.mjs"
