{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2022"
    ],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true
  },
  "include": [
    "src",
    "tests/unit",
    "tests/integration",
    "tests/helpers",
    "vitest.config.ts"
  ],
  "exclude": [
    "src/webview/ui",
    "src/webview/ticket",
    "src/webview/note",
    "src/webview/metrics"
  ]
}
