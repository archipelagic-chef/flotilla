{
  "title": "A ticket's Changes narrowed to one of its commits and by path; a report's link to a changed file has a diff mark that opens its diff at the line",
  "settings": { "flotilla.ci.notify": "off", "flotilla.notify": "off" },
  "steps": [
    { "command": "Close All Editor Groups" },
    { "command": "Notifications: Clear All Notifications" },
    { "command": "Focus on Flotilla View" },
    { "click": "[aria-label=\"Backlog\"]" },
    { "wait": 800 },
    { "click": ".backlog-item:has-text(\"Keep chats when a window reloads\")" },
    { "waitFor": "h1:has-text(\"Keep chats when a window reloads\")" },
    { "caption": "1. The ticket's Changes: all its work, committed or not" },
    { "waitFor": ".change-file:has-text(\"reload.js\")" },
    { "hover": ".changes .changes-total" },
    { "wait": 1800 },
    { "caption": "2. Narrowed to one of its commits: what that round changed" },
    { "click": ".changes-picker > button" },
    { "waitFor": ".changes-commit:has-text(\"Find the chat again\")" },
    { "wait": 800 },
    { "click": ".changes-commit:has-text(\"Find the chat again\") input" },
    { "waitFor": ".changes-picker > button:has-text(\"1 commit\"):not(:has-text(\"…\"))" },
    { "click": ".changes .block-head h2" },
    { "waitFor": ".changes-total:has-text(\"1 file\")" },
    { "waitFor": ".change-file:has-text(\"chats.js\")" },
    { "wait": 2200 },
    { "caption": "Back to all of it, then a path filter" },
    { "click": ".changes-picker > button" },
    { "click": ".changes-commit:has-text(\"All of its change\")" },
    { "waitFor": ".change-file:has-text(\"reload.js\")" },
    { "click": ".changes-filter input" },
    { "type": "reload" },
    { "waitFor": ".changes-total:has-text(\"1 file\")" },
    { "wait": 2200 },
    { "caption": "3. A report's link to a changed file: its diff mark opens the diff at the line" },
    { "hover": ".rendered a[href=\"src/chats.js#L6\"] + .diff-mark" },
    { "wait": 1200 },
    { "click": ".rendered a[href=\"src/chats.js#L6\"] + .diff-mark" },
    { "waitFor": ".tab.active:has-text(\"chats.js\")" },
    { "wait": 2500 },
    { "caption": "" }
  ]
}
