{
  "title": "An expanded file goes through its ticket By commit: the sidebar steps through the ticket's commits (Previous, or a row of the list), each with its whole message, and the file shows its diff in the commit you're on; Whole change switches both back, and Back leaves the commits for the Backlog",
  "settings": { "flotilla.ci.notify": "off", "flotilla.notify": "off" },
  "steps": [
    { "command": "Close All Editor Groups" },
    { "command": "Notifications: Clear All Notifications" },
    { "command": "Focus on Flotilla View" },
    { "click": "[aria-label=\"Backlog\"]" },
    { "wait": 800 },
    { "click": ".backlog-item:has-text(\"Keep chats when a window reloads\")" },
    { "waitFor": "h1:has-text(\"Keep chats when a window reloads\")" },
    { "waitFor": ".change-file:has-text(\"chats.js\")" },
    { "click": ".change-file:has-text(\"chats.js\") .change-unfold" },
    { "waitFor": ".change-hunk .change-action" },
    { "click": ".change-hunk .change-action" },
    { "waitFor": ".diff-view .diff-view-mode" },
    { "caption": "A switch beside Back to BL-3: Whole change, or By commit" },
    { "highlight": ".diff-view-mode" },
    { "wait": 2500 },
    { "highlight": "" },
    { "hover": ".diff-view-mode button:has-text(\"By commit\")" },
    { "wait": 600 },
    { "click": ".diff-view-mode button:has-text(\"By commit\")" },
    { "waitFor": ".commit-step" },
    { "waitFor": ".diff-view-compared:has-text(\"In \")" },
    { "caption": "By commit: the sidebar on BL-3's commits, at the latest that changes chats.js" },
    { "highlight": ".commit-step" },
    { "wait": 2000 },
    { "caption": "Each commit's whole message: its subject, then its body" },
    { "waitFor": ".ticket-commit-body" },
    { "highlight": ".ticket-commit-body" },
    { "wait": 3000 },
    { "caption": "The file shows its diff in that commit" },
    { "highlight": ".diff-view-file" },
    { "wait": 2500 },
    { "highlight": "" },
    { "caption": "Previous: the commit before, in both places" },
    { "hover": "[aria-label=\"Previous Commit\"]" },
    { "wait": 600 },
    { "click": "[aria-label=\"Previous Commit\"]" },
    { "waitFor": ".diff-view-crumbs .crumb:has-text(\"Commit 1 of\")" },
    { "highlight": ".diff-view" },
    { "wait": 2500 },
    { "highlight": "" },
    { "caption": "Or jump to any commit in the list: the file follows" },
    { "hover": ".ticket-commit-row:has-text(\"Find the chat again\")" },
    { "wait": 600 },
    { "click": ".ticket-commit-row:has-text(\"Find the chat again\")" },
    { "waitFor": ".diff-view-crumbs .crumb:has-text(\"Commit 2 of\")" },
    { "highlight": ".diff-view-bar" },
    { "wait": 2500 },
    { "highlight": "" },
    { "caption": "Next file, still in that commit: reload.js isn't in it" },
    { "hover": "[title=\"The file after it in Changes\"]" },
    { "wait": 600 },
    { "click": "[title=\"The file after it in Changes\"]" },
    { "waitFor": ".diff-view-body .work-empty:has-text(\"doesn't change it\")" },
    { "highlight": ".diff-view-body .work-empty" },
    { "wait": 2500 },
    { "highlight": "" },
    { "caption": "Whole change: the ticket's whole diff again, the sidebar on its Changes" },
    { "hover": ".diff-view-mode button:has-text(\"Whole change\")" },
    { "wait": 600 },
    { "click": ".diff-view-mode button:has-text(\"Whole change\")" },
    { "waitFor": ".diff-view-crumbs .crumb:text-is(\"Changes\")" },
    { "highlight": ".diff-view-bar" },
    { "wait": 2500 },
    { "highlight": "" },
    { "caption": "By commit again, then Back to BL-3: the ticket, and the sidebar on the Backlog" },
    { "click": ".diff-view-mode button:has-text(\"By commit\")" },
    { "waitFor": ".commit-step" },
    { "wait": 1500 },
    { "hover": ".diff-view-back" },
    { "wait": 800 },
    { "click": ".diff-view-back" },
    { "waitFor": ".backlog-item:has-text(\"Keep chats when a window reloads\")" },
    { "highlight": ".backlog-item:has-text(\"Keep chats when a window reloads\")" },
    { "wait": 2500 },
    { "highlight": "" },
    { "caption": "" }
  ]
}
