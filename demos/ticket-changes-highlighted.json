{
  "title": "A ticket's diffs are syntax-highlighted, inline and in the full view (Expand), in the theme's colours, on top of the added and deleted lines",
  "settings": { "flotilla.ci.notify": "off", "flotilla.notify": "off" },
  "steps": [
    { "command": "Close All Editor Groups" },
    { "command": "Notifications: Clear All Notifications" },
    { "command": "Focus on Flotilla View" },
    { "click": "[aria-label=\"Backlog\"]" },
    { "wait": 800 },
    { "click": ".backlog-item:has-text(\"Keep chats when a window reloads\")" },
    { "waitFor": "h1:has-text(\"Keep chats when a window reloads\")" },
    { "caption": "1. A file's diff unfolds inline in the ticket's Changes" },
    { "hover": ".changes .block-head" },
    { "waitFor": ".change-file:has-text(\"reload.js\")" },
    { "click": ".change-file:has-text(\"reload.js\") .change-unfold" },
    { "waitFor": ".change-line .tok-keyword" },
    { "caption": "Its code is coloured as in the editor: keywords, strings, names, comments" },
    { "highlight": ":nth-match(.change-hunk, 1)" },
    { "wait": 3000 },
    { "highlight": "" },
    { "caption": "2. Expand: the whole file's diff, coloured the same way" },
    { "hover": ":nth-match(.change-hunk, 1) .change-action" },
    { "wait": 800 },
    { "click": ":nth-match(.change-hunk, 1) .change-action" },
    { "waitFor": ".diff-view .full-row .tok-keyword" },
    { "highlight": ".diff-view .full-row.added" },
    { "wait": 3000 },
    { "highlight": "" },
    { "caption": "3. In a light theme, the colours follow it" },
    { "command": "Preferences: Toggle between Light/Dark Themes" },
    { "wait": 3000 },
    { "command": "Preferences: Toggle between Light/Dark Themes" },
    { "caption": "" }
  ]
}
