{
  "title": "Files, Search and Version Control are sub-views of the Backlog: they show the item selected in it, main when nothing else is",
  "settings": { "flotilla.ci.notify": "off", "flotilla.notify": "off" },
  "steps": [
    { "command": "Close All Editor Groups" },
    { "command": "Notifications: Clear All Notifications" },
    { "command": "Focus on Flotilla View" },
    { "click": "nav.tools [aria-label=\"Backlog\"]" },
    { "waitFor": ".main-row.current" },
    { "caption": "Under the Backlog in the tool strip: its list, then Files, Search and Version Control" },
    { "highlight": "[aria-label=\"Backlog views\"]" },
    { "wait": 2500 },
    { "caption": "Nothing selected: main is, pinned at the top of the Backlog" },
    { "highlight": ".main-row.current" },
    { "wait": 2500 },
    { "highlight": "" },
    { "caption": "Click a card: BL-3 is selected, highlighted" },
    { "click": ".backlog-item:has-text(\"Keep chats when a window reloads\")" },
    { "waitFor": ".backlog-item.current:has-text(\"Keep chats when a window reloads\")" },
    { "highlight": ".backlog-item.current" },
    { "wait": 2000 },
    { "highlight": "" },
    { "caption": "The bar at the top names the selected item, and stays there as the Backlog scrolls" },
    { "hover": ".content .backlog-item >> nth=-1" },
    { "highlight": ".picked-head:has-text(\"BL-3\")" },
    { "wait": 2500 },
    { "highlight": "" },
    { "caption": "Clicking it shows its card again" },
    { "click": ".picked-name" },
    { "highlight": ".backlog-item.current" },
    { "wait": 2000 },
    { "highlight": "" },
    { "caption": "Files shows BL-3's worktree; the same bar names it" },
    { "click": "[aria-label=\"Backlog: Files\"]" },
    { "waitFor": ".picked-name:has-text(\"BL-3\")" },
    { "highlight": ".picked-head" },
    { "wait": 2500 },
    { "highlight": "" },
    { "caption": "Search searches in it" },
    { "click": "[aria-label=\"Backlog: Search\"]" },
    { "click": "#flotilla-search" },
    { "type": "chat" },
    { "wait": 2000 },
    { "caption": "Version Control: BL-3's Changes, Commits and CI, under its pinned card" },
    { "click": "[aria-label=\"Backlog: Version Control\"]" },
    { "waitFor": ".ticket-vc-card .backlog-item" },
    { "highlight": "[aria-label=\"BL-3's Version Control\"]" },
    { "wait": 2500 },
    { "highlight": "" },
    { "caption": "Back to Files; its header goes back to BL-3's card" },
    { "click": "[aria-label=\"Backlog: Files\"]" },
    { "click": ".picked-name" },
    { "waitFor": ".backlog-item.current" },
    { "wait": 1500 },
    { "caption": "Deselect: click main, and Files shows main" },
    { "click": ".main-row" },
    { "waitFor": ".main-row.current" },
    { "click": "[aria-label=\"Backlog: Files\"]" },
    { "waitFor": ".picked-name:has-text(\"main\")" },
    { "highlight": ".picked-head" },
    { "wait": 2500 },
    { "highlight": "" },
    { "caption": "BL-3's tab is still the active editor: a click on its card selects it again" },
    { "click": "[aria-label=\"Backlog: All Tickets\"]" },
    { "click": ".backlog-item:has-text(\"Keep chats when a window reloads\")" },
    { "waitFor": ".backlog-item.current:has-text(\"Keep chats when a window reloads\")" },
    { "highlight": ".backlog-item.current" },
    { "wait": 2500 },
    { "highlight": "" },
    { "caption": "" }
  ]
}
