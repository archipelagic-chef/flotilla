{
  "title": "Discard a ticket as won't do: it folds into Discarded, its ticket shows Won't Do, and another status reopens it",
  "steps": [
    {
      "command": "Focus on Flotilla View"
    },
    {
      "click": "[aria-label=\"Backlog\"]"
    },
    {
      "waitFor": ".backlog-item:has-text(\"Start a ticket from the keyboard\")"
    },
    {
      "caption": "A card's actions have Discard, next to its other actions"
    },
    {
      "hover": ".backlog-item:has-text(\"Start a ticket from the keyboard\") .name"
    },
    {
      "wait": 800
    },
    {
      "click": ".backlog-item:has-text(\"Start a ticket from the keyboard\") [aria-label=\"Discard (Won't Do)\u2026\"]"
    },
    {
      "caption": "It asks once: the ticket is kept, and can be reopened"
    },
    {
      "waitFor": ".monaco-dialog-box .monaco-button:has-text(\"Discard\")"
    },
    {
      "wait": 1500
    },
    {
      "click": ".monaco-dialog-box .monaco-button:has-text(\"Discard\")"
    },
    {
      "caption": "It leaves the lanes, for a folded Discarded section after Done"
    },
    {
      "waitFor": ".discarded-lane"
    },
    {
      "click": ".discarded-lane .group-head"
    },
    {
      "waitFor": ".discarded-lane .backlog-item:has-text(\"Start a ticket from the keyboard\")"
    },
    {
      "wait": 1500
    },
    {
      "caption": "Its ticket shows Won't Do as its status, and says when it was discarded"
    },
    {
      "click": ".discarded-lane .backlog-item:has-text(\"Start a ticket from the keyboard\") .name"
    },
    {
      "waitFor": "[role=\"radio\"][aria-checked=\"true\"]:has-text(\"Won't Do\")"
    },
    {
      "wait": 1800
    },
    {
      "caption": "Another status reopens it into that one: To Do, here"
    },
    {
      "click": "[role=\"radio\"]:has-text(\"To Do\")"
    },
    {
      "waitFor": "[role=\"radio\"][aria-checked=\"true\"]:has-text(\"To Do\")"
    },
    {
      "waitFor": ".backlog-item:not(.discarded-lane *):has-text(\"Start a ticket from the keyboard\")"
    },
    {
      "wait": 2000
    },
    {
      "caption": ""
    }
  ]
}
