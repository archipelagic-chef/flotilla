{
  "title": "The Security panel: the policy sandboxed agents run under, set by you",
  "steps": [
    { "command": "Flotilla: Security" },
    { "waitFor": ".security h1" },
    { "caption": "With the sandbox off, the panel says so and offers to turn it on" },
    { "highlight": ".security-banner" },
    { "wait": 2000 },
    { "caption": "One policy for all repositories, or this repository's own: the panel shows which is in force, and its file" },
    { "click": ".security-switch button:has-text(\"This repository\")" },
    { "waitFor": ".security-status:has-text(\"own policy\")" },
    { "highlight": ".security-scope" },
    { "wait": 1500 },
    { "highlight": ".security-file" },
    { "wait": 2000 },
    { "caption": "Files: Flotilla's own folders are fixed rows, with their reason; they apply at the agent's next start" },
    { "highlight": "[data-testid=\"security-files\"]" },
    { "wait": 3000 },
    { "highlight": "" },
    { "caption": "Network: hosts apply at once, in running sandboxes. Add one" },
    { "click": "button:has-text(\"+ Add host\")" },
    { "click": "[data-testid=\"security-network\"] input[aria-label=\"Host\"] >> nth=-1" },
    { "type": "registry.npmjs.org:abc" },
    { "click": ".security-button:has-text(\"Save\")" },
    { "waitFor": ".security-error" },
    { "caption": "Saving checks the policy first: the error shows next to its rule" },
    { "highlight": "[data-testid=\"security-network\"]" },
    { "wait": 2500 },
    { "highlight": "" },
    { "click": "[data-testid=\"security-network\"] input[aria-label=\"Host\"] >> nth=-1" },
    { "press": "Control+A" },
    { "type": "registry.npmjs.org" },
    { "click": ".security-button:has-text(\"Save\")" },
    { "waitFor": ".security-status:has-text(\"Saved\")" },
    { "caption": "Saved: it says what applies now and what waits for each agent's next start" },
    { "highlight": ".security-status" },
    { "wait": 2500 },
    { "caption": "Reset brings back Flotilla's strict default" },
    { "click": ".security-button:has-text(\"Reset\")" },
    { "highlight": "[data-testid=\"security-network\"]" },
    { "wait": 2000 },
    { "highlight": "" },
    { "caption": "" }
  ]
}
