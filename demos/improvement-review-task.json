{
  "title": "The improvement review is a scheduled task: its card in Scheduled with its reports, its file, and Review Now running it",
  "settings": { "flotilla.agents.maxRunning": 4 },
  "steps": [
    { "caption": "Scheduled: the improvement review is a task like any other, next to the docs check" },
    { "click": "[aria-label=\"Scheduled\"]" },
    { "waitFor": ".scheduled-task:has-text(\"Improvement review\")" },
    { "highlight": ".scheduled-task:has-text(\"Improvement review\")" },
    { "wait": 2500 },
    { "caption": "Every 7 days, when idle: its last report and when it runs next" },
    { "highlight": ".scheduled-task:has-text(\"Improvement review\") .scheduled-schedule" },
    { "wait": 2000 },
    { "highlight": "" },
    { "caption": "Its earlier reports are its own: the reviews written before it was a task" },
    { "click": ".scheduled-task:has-text(\"Improvement review\") .scheduled-more" },
    { "wait": 1500 },
    { "click": ".scheduled-task:has-text(\"Improvement review\") .scheduled-report >> nth=0" },
    { "waitFor": ".page h1:has-text(\"merges wait\")" },
    { "wait": 2500 },
    { "caption": "Edit opens its file: its schedule and instructions are yours to change; context: metrics gives it the numbers" },
    { "click": "[aria-label=\"Scheduled\"]" },
    { "click": "[aria-label=\"Edit Improvement review\"]" },
    { "waitFor": ".monaco-editor:has-text(\"context: metrics\")" },
    { "highlight": ".monaco-editor .view-lines" },
    { "wait": 3000 },
    { "highlight": "" },
    { "caption": "The Metrics view's reviews are the same reports, and Review Now runs the task" },
    { "click": "[aria-label=\"Metrics\"]" },
    { "waitFor": ".metrics-reviews-list" },
    { "highlight": ".metrics-reviews" },
    { "wait": 2500 },
    { "click": ".metrics-review-now" },
    { "waitFor": ".metrics-reviews-running" },
    { "highlight": ".metrics-reviews-running" },
    { "wait": 2000 },
    { "caption": "In Scheduled, its card says it's running" },
    { "click": "[aria-label=\"Scheduled\"]" },
    { "waitFor": ".scheduled-task:has-text(\"Improvement review\") .scheduled-status.running" },
    { "highlight": ".scheduled-task:has-text(\"Improvement review\")" },
    { "wait": 2500 },
    { "caption": "When it's written, it's the task's last report, and opens as a page" },
    { "waitFor": ".scheduled-task:has-text(\"Improvement review\") .scheduled-status:not(.running)", "timeout": 30000 },
    { "highlight": ".scheduled-task:has-text(\"Improvement review\") .scheduled-report >> nth=0" },
    { "wait": 1500 },
    { "click": ".scheduled-task:has-text(\"Improvement review\") .scheduled-report >> nth=0" },
    { "waitFor": ".page h1:has-text(\"a fake review\")" },
    { "wait": 2500 },
    { "highlight": "" },
    { "caption": "" }
  ]
}
