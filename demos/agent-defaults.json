{
  "title": "Choose the agents' default model and effort from the backlog's title bar",
  "steps": [
    { "command": "Focus on Flotilla View" },
    { "click": "[aria-label=\"Backlog\"]" },
    { "waitFor": ".agent-defaults" },
    { "caption": "The backlog's title bar shows the agents' default model and effort" },
    { "wait": 1200 },
    { "click": ".agent-defaults" },
    { "caption": "First the model, for every ticket that hasn't chosen its own" },
    { "waitFor": ".quick-input-widget .quick-input-list-row:has-text(\"Sonnet\")" },
    { "wait": 1200 },
    { "type": "Sonnet" },
    { "press": "Enter" },
    { "caption": "Then the effort" },
    { "waitFor": ".quick-input-widget .quick-input-list-row:has-text(\"High\")" },
    { "wait": 1000 },
    { "type": "High" },
    { "press": "Enter" },
    { "caption": "Saved in the workspace's settings: the button says Sonnet · high" },
    { "waitFor": ".agent-defaults-label:has-text(\"Sonnet · high\")" },
    { "wait": 2000 },
    { "caption": "A ticket's Model menu shows the new default, and Change Default… opens the same picks" },
    { "click": ".backlog-item:has-text(\"Sort the backlog by priority\") .name" },
    { "waitFor": "h1:has-text(\"Sort the backlog by priority\")" },
    { "click": "[aria-label^=\"Agents' model\"]" },
    { "waitFor": "text=Default (Sonnet)" },
    { "wait": 2500 },
    { "press": "Escape" },
    { "caption": "" }
  ]
}
