{
  "title": "Choose the agents' default model and effort in the backlog's title bar",
  "steps": [
    { "command": "Focus on Flotilla View" },
    { "click": "[aria-label=\"Backlog\"]" },
    { "waitFor": ".agent-default-model" },
    { "caption": "The backlog's title bar: the agents' default model, and its effort next to it" },
    { "wait": 1200 },
    { "click": ".agent-default-model .agent-default-button" },
    { "caption": "The model, for every ticket that hasn't chosen its own" },
    { "waitFor": ".agent-default-menu button:has-text(\"Sonnet\")" },
    { "wait": 1200 },
    { "click": ".agent-default-menu button:has-text(\"Sonnet\")" },
    { "waitFor": ".agent-default-model .agent-default-text:has-text(\"Sonnet\")" },
    { "caption": "Then the effort, right next to it" },
    { "click": ".agent-default-effort .agent-default-button" },
    { "waitFor": ".agent-default-menu button:has-text(\"High\")" },
    { "wait": 1000 },
    { "click": ".agent-default-menu button:has-text(\"High\")" },
    { "caption": "Saved in the workspace's settings: Sonnet, High" },
    { "waitFor": ".agent-default-effort .agent-default-text:has-text(\"High\")" },
    { "wait": 2000 },
    { "caption": "A ticket's Model menu shows the new default" },
    { "click": ".backlog-item:has-text(\"Sort the backlog by priority\") .name" },
    { "waitFor": "h1:has-text(\"Sort the backlog by priority\")" },
    { "click": "[aria-label^=\"Agents' model\"]" },
    { "waitFor": "text=Default (Sonnet)" },
    { "wait": 2500 },
    { "press": "Escape" },
    { "caption": "" }
  ]
}
