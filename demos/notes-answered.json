{
  "title": "A note's questions show in the reply that asks, and once answered, with what you picked",
  "settings": { "flotilla.agents.maxRunning": 6 },
  "steps": [
    { "click": "[aria-label=\"Backlog\"]" },
    { "click": "[aria-label^=\"New Note\"]" },
    { "waitFor": ".note-page .comment-box textarea" },
    { "wait": 800 },
    { "type": "Tags on tickets, to filter the board fake: ask" },
    { "wait": 600 },
    { "press": "Control+Enter" },
    { "hover": ".notes-lane .group-head" },
    { "waitFor": ".note-card.note-asking", "timeout": 60000 },
    { "click": ".note-card.note-asking .note-title" },
    { "waitFor": ".note-page .note-entry .note-questions .choice:has-text(\"An epic with parts\")" },
    { "caption": "Its agent's questions are in its reply, where it asked" },
    { "highlight": ".note-page .note-entry:has(.note-questions)" },
    { "wait": 1500 },
    { "click": ".note-page .note-questions .choice:has-text(\"An epic with parts\")" },
    { "click": ".note-page .comment-box:last-of-type textarea" },
    { "type": "And keep the tags short." },
    { "wait": 600 },
    { "command": "Notifications: Clear All Notifications" },
    { "click": ".note-page button.note-comment" },
    { "waitFor": ".note-page .note-entry .needs.answered" },
    { "caption": "Answered, the reply keeps its questions, with what you picked, read-only" },
    { "highlight": ".note-page .note-entry .needs.answered" },
    { "wait": 2500 },
    { "caption": "Your entry shows only what else you wrote" },
    { "highlight": ".note-page .note-entry-you:has-text(\"And keep the tags short.\")" },
    { "wait": 2500 },
    { "caption": "" }
  ]
}
