{
  "title": "Land, Resolving Conflicts on one ticket: it lands on its own, an agent resolving its conflict, approved without asking",
  "settings": {
    "flotilla.merge.checks": "local",
    "flotilla.merge.onApprove": "off"
  },
  "steps": [
    {
      "click": "[aria-label=\"Backlog\"]"
    },
    {
      "click": ".backlog-item:has-text(\"Remember the last open ticket\") .name"
    },
    {
      "waitFor": "h1:has-text(\"Remember the last open ticket\")"
    },
    {
      "click": ".review-panel button:has-text(\"Approve\")"
    },
    {
      "waitFor": ".merge-queue-bar:has-text(\"BL-10\")",
      "timeout": 60000
    },
    {
      "click": ".backlog-item:has-text(\"Remember the last open tab\") .name"
    },
    {
      "waitFor": "h1:has-text(\"Remember the last open tab\")"
    },
    {
      "click": ".review-panel button:has-text(\"Approve\")"
    },
    {
      "caption": "BL-15 conflicts with BL-10, ahead of it in the queue. Next to Merge to main: Land, Resolving Conflicts"
    },
    {
      "highlight": ".review-panel:has-text(\"2nd of 2\") button.land-resolving"
    },
    {
      "highlight": ""
    },
    {
      "click": ".review-panel:has-text(\"2nd of 2\") button.land-resolving"
    },
    {
      "caption": "One click, no dialogs: an agent resolves BL-15's conflict, and its resolution is approved without asking"
    },
    {
      "waitFor": ".merge-queue-bar:has-text(\"BL-15 (resolving)\")",
      "timeout": 60000
    },
    {
      "highlight": ".merge-queue-bar a:has-text(\"BL-15\")"
    },
    {
      "wait": 2000
    },
    {
      "caption": "Resolved, BL-10 and BL-15 land after their checks. The fake agent can't resolve it: BL-15 waits for you"
    },
    {
      "waitFor": ".notification-toast:has-text(\"BL-15 needs you\")",
      "timeout": 90000
    },
    {
      "waitFor": ".merge-queue-bar:has-text(\"BL-15 (needs you)\")",
      "timeout": 60000
    },
    {
      "highlight": ".merge-queue-bar a:has-text(\"BL-15\")"
    },
    {
      "wait": 2500
    },
    {
      "highlight": ""
    },
    {
      "caption": ""
    }
  ]
}
