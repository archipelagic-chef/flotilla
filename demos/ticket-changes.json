{
  "title": "A ticket's Changes preview its files; Expand opens the ticket in Version Control: its header, its Changes in full and its Commits to step through, and Back to the ticket",
  "settings": { "flotilla.ci.notify": "off", "flotilla.notify": "off" },
  "steps": [
    { "command": "Close All Editor Groups" },
    { "command": "Notifications: Clear All Notifications" },
    { "command": "Focus on Flotilla View" },
    { "click": "[aria-label=\"Backlog\"]" },
    { "wait": 800 },
    { "click": ".backlog-item:has-text(\"Keep chats when a window reloads\")" },
    { "waitFor": "h1:has-text(\"Keep chats when a window reloads\")" },
    { "caption": "1. The ticket's Changes preview: its files, +/− each, a file's diff unfolds inline" },
    { "hover": ".changes .block-head" },
    { "waitFor": ".change-file:has-text(\"reload.js\")" },
    { "click": ".change-file:has-text(\"reload.js\") .change-unfold" },
    { "waitFor": ":nth-match(.change-hunk, 2)" },
    { "wait": 2500 },
    { "caption": "2. Expand opens it: Version Control in the sidebar, on BL-3's Changes" },
    { "hover": ":nth-match(.change-hunk, 2) .change-action" },
    { "wait": 1000 },
    { "click": ":nth-match(.change-hunk, 2) .change-action" },
    { "waitFor": ".ticket-file.selected:has-text(\"reload.js\")" },
    { "wait": 1500 },
    { "caption": "Its header says it's BL-3's, and leads back to it (in every Version Control view)" },
    { "hover": ".ticket-vc-head" },
    { "wait": 2500 },
    { "caption": "BL-3's Changes: every file it changes, in full; a click opens its diff" },
    { "hover": ".ticket-file:has-text(\"chats.js\")" },
    { "wait": 800 },
    { "click": ".ticket-file:has-text(\"chats.js\")" },
    { "wait": 2500 },
    { "caption": "3. BL-3's Commits: one at a time, back and forth" },
    { "hover": "[aria-label=\"Version Control: BL-3's Commits\"]" },
    { "wait": 800 },
    { "click": "[aria-label=\"Version Control: BL-3's Commits\"]" },
    { "waitFor": ".commit-step" },
    { "wait": 1500 },
    { "hover": "[aria-label=\"Previous Commit\"]" },
    { "click": "[aria-label=\"Previous Commit\"]" },
    { "wait": 1800 },
    { "hover": "[aria-label=\"Next Commit\"]" },
    { "click": "[aria-label=\"Next Commit\"]" },
    { "wait": 1800 },
    { "caption": "Back to BL-3: the ticket, its Changes at the file you were on" },
    { "hover": ".ticket-back" },
    { "wait": 1000 },
    { "click": ".ticket-back" },
    { "waitFor": ".change-file.current:has-text(\"chats.js\")" },
    { "wait": 2500 },
    { "caption": "" }
  ]
}
