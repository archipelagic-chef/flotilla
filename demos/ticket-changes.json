{
  "title": "A ticket's Changes say how big the change is and list its biggest files, each opening its diff; View Version Control shows all of it under the ticket's card in the Backlog; a report's link to one of its files opens its diff at the line",
  "settings": {
    "flotilla.ci.notify": "off",
    "flotilla.notify": "off"
  },
  "steps": [
    {
      "click": "[aria-label=\"Backlog\"]"
    },
    {
      "wait": 800
    },
    {
      "click": ".backlog-item:has-text(\"Keep chats when a window reloads\")"
    },
    {
      "waitFor": "h1:has-text(\"Keep chats when a window reloads\")"
    },
    {
      "hover": ".changes .block-head"
    },
    {
      "waitFor": ".changes .change-file:has-text(\"chats.js\")"
    },
    {
      "caption": "BL-3's Changes: how big it is, its three biggest files, and View Version Control. No file tree or diffs of its own"
    },
    {
      "highlight": ".changes"
    },
    {
      "wait": 3500
    },
    {
      "highlight": ""
    },
    {
      "caption": "A file opens its diff in the ticket's place, not beside it, and the Backlog shows BL-3's Changes, that file selected"
    },
    {
      "hover": ".changes .change-file:has-text(\"reload.js\")"
    },
    {
      "wait": 800
    },
    {
      "click": ".changes .change-file:has-text(\"reload.js\")"
    },
    {
      "waitFor": ".monaco-diff-editor"
    },
    {
      "highlight": ".editor-group-container"
    },
    {
      "wait": 2500
    },
    {
      "highlight": ""
    },
    {
      "waitFor": ".ticket-vc-card .backlog-item"
    },
    {
      "highlight": ".ticket-vc"
    },
    {
      "wait": 3000
    },
    {
      "highlight": ""
    },
    {
      "caption": "Back to BL-3 brings the ticket back where it was. View Version Control leads to the same place"
    },
    {
      "hover": ".statusbar-item[id$=\"flotilla.backToTicket\"]"
    },
    {
      "highlight": ".statusbar-item[id$=\"flotilla.backToTicket\"]"
    },
    {
      "wait": 1200
    },
    {
      "highlight": ""
    },
    {
      "click": ".statusbar-item[id$=\"flotilla.backToTicket\"]"
    },
    {
      "waitFor": "h1:has-text(\"Keep chats when a window reloads\")"
    },
    {
      "hover": ".changes .view-vc"
    },
    {
      "highlight": ".changes .view-vc"
    },
    {
      "wait": 1500
    },
    {
      "click": ".changes .view-vc"
    },
    {
      "waitFor": ".ticket-vc-card .backlog-item"
    },
    {
      "highlight": ".ticket-vc"
    },
    {
      "wait": 2500
    },
    {
      "highlight": ""
    },
    {
      "caption": "A report's link to a file BL-3 changes opens that file's diff, at the line, and the Backlog shows BL-3's Changes"
    },
    {
      "hover": "a.change-link:has-text(\"src/chats.js:6\")"
    },
    {
      "highlight": "a.change-link:has-text(\"src/chats.js:6\")"
    },
    {
      "wait": 1500
    },
    {
      "highlight": ""
    },
    {
      "click": "a.change-link:has-text(\"src/chats.js:6\")"
    },
    {
      "waitFor": ".monaco-diff-editor"
    },
    {
      "highlight": ".editor-group-container"
    },
    {
      "wait": 2000
    },
    {
      "highlight": ".ticket-vc"
    },
    {
      "wait": 3000
    },
    {
      "highlight": ""
    },
    {
      "caption": ""
    }
  ]
}
