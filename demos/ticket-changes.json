{
  "title": "A ticket's Changes, from a glance to the detail: a file's diff inline, Expand to the whole file in the ticket's own tab, and Back to where you were",
  "settings": { "flotilla.ci.notify": "off", "flotilla.notify": "off" },
  "steps": [
    { "command": "Close All Editor Groups" },
    { "command": "Notifications: Clear All Notifications" },
    { "command": "Focus on Flotilla View" },
    { "click": "[aria-label=\"Backlog\"]" },
    { "wait": 800 },
    { "click": ".backlog-item:has-text(\"Keep chats when a window reloads\")" },
    { "waitFor": "h1:has-text(\"Keep chats when a window reloads\")" },
    { "command": "View: Close Primary Side Bar" },
    { "caption": "1. A glance: the files BL-3 changes, with +/− per file" },
    { "hover": ".changes .block-head" },
    { "waitFor": ".change-file:has-text(\"reload.js\")" },
    { "wait": 2000 },
    { "caption": "2. A file unfolds its changes right here, in the ticket" },
    { "click": ".change-file:has-text(\"reload.js\") .change-unfold" },
    { "waitFor": ":nth-match(.change-hunk, 2)" },
    { "wait": 2500 },
    { "caption": "3. Expand a change: the whole file fills the ticket's tab" },
    { "hover": ":nth-match(.change-hunk, 2) .change-action" },
    { "wait": 1000 },
    { "click": ":nth-match(.change-hunk, 2) .change-action" },
    { "waitFor": ".diff-view .full-gap" },
    { "wait": 1500 },
    { "caption": "Its top bar says it's still BL-3's: BL-3 › Changes › src/reload.js" },
    { "hover": ".diff-view-crumbs" },
    { "wait": 2500 },
    { "caption": "The lines between the changes fold; a click shows them" },
    { "hover": ".diff-view .full-gap" },
    { "wait": 800 },
    { "click": ".diff-view .full-gap" },
    { "waitFor": ".diff-view .full-row:has-text(\"export function forget\")" },
    { "wait": 2000 },
    { "caption": "Back to BL-3: the ticket again, just where you were" },
    { "hover": ".diff-view-back" },
    { "wait": 1200 },
    { "click": ".diff-view-back" },
    { "waitFor": ".change-file.current:has-text(\"reload.js\")" },
    { "wait": 2500 },
    { "caption": "" }
  ]
}
