{
  "title": "A ticket's Changes, from a glance to the detail: the files, a diff inline, the file expanded to the whole tab, and back",
  "steps": [
    { "command": "Close All Editor Groups" },
    { "command": "Notifications: Clear All Notifications" },
    { "command": "Focus on Flotilla View" },
    { "click": "[aria-label=\"Backlog\"]" },
    { "wait": 800 },
    { "click": ".backlog-item:has-text(\"Keep chats when a window reloads\")" },
    { "waitFor": "h1:has-text(\"Keep chats when a window reloads\")" },
    { "caption": "1. A glance: the files the ticket changes, with +/− per file" },
    { "hover": ".changes .block-head" },
    { "waitFor": ".change-file:has-text(\"chats.js\")" },
    { "wait": 2000 },
    { "caption": "2. A file unfolds its diff right here, in the ticket" },
    { "click": ".change-file:has-text(\"chats.js\") .change-unfold" },
    { "waitFor": ".change-hunk" },
    { "wait": 2500 },
    { "caption": "3. Expand: the whole file, in the ticket's whole tab" },
    { "hover": ".change-hunk .change-action" },
    { "wait": 800 },
    { "click": ".change-hunk .change-action" },
    { "waitFor": ".diff-view .full-row" },
    { "wait": 1500 },
    { "caption": "Its top bar keeps it the ticket's: BL-3 › Changes › the file" },
    { "hover": ".diff-view-crumbs" },
    { "wait": 2200 },
    { "caption": "Next goes through the ticket's files, one by one" },
    { "click": ".diff-view-actions button:has-text(\"Next\")" },
    { "waitFor": ".diff-view-crumbs .current:has-text(\"notes.txt\")" },
    { "wait": 1800 },
    { "caption": "Back to BL-3: the ticket, just where you were" },
    { "hover": ".diff-view-back" },
    { "wait": 1200 },
    { "click": ".diff-view-back" },
    { "waitFor": ".change-file.current" },
    { "hover": ".changes .block-head" },
    { "wait": 2500 },
    { "caption": "" }
  ]
}
