{
  "title": "Write a formatted note in the New Note tab, and an agent turns it into a ticket proposal",
  "settings": { "flotilla.agents.maxRunning": 6 },
  "steps": [
    { "command": "Focus on Flotilla View" },
    { "click": "[aria-label=\"Backlog\"]" },
    { "caption": "New Note opens a note to write as you'd write a comment on a ticket" },
    { "click": "[aria-label^=\"New Note\"]" },
    { "waitFor": ".note-page .comment-box textarea" },
    { "wait": 800 },
    { "type": "Export the backlog as CSV" },
    { "press": "Enter" },
    { "press": "Enter" },
    { "caption": "The formatting toolbar, as on a ticket: bold, lists, code, links…" },
    { "click": ".note-page .md-formats [aria-label=\"Bold\"]" },
    { "type": "Why:" },
    { "press": "End" },
    { "type": " I want to open it in a spreadsheet." },
    { "press": "Enter" },
    { "press": "Enter" },
    { "click": ".note-page .md-formats [aria-label=\"Bulleted list\"]" },
    { "type": "one row per ticket" },
    { "press": "Enter" },
    { "type": "with its status and priority" },
    { "wait": 600 },
    { "caption": "Preview shows it formatted" },
    { "click": ".note-page .md-tab:has-text(\"Preview\")" },
    { "waitFor": ".note-page .rendered strong" },
    { "wait": 2000 },
    { "caption": "Send gives it to an agent: it shows in the Notes lane, under Needs you" },
    { "click": ".note-page button:has-text(\"Send to an Agent\")" },
    { "hover": ".notes-lane .group-head" },
    { "waitFor": ".note-card:has-text(\"Export the backlog\")" },
    { "waitFor": ".note-working:has-text(\"Export the backlog\")", "timeout": 60000 },
    { "caption": "The agent reads the code and the backlog, and writes the proposal" },
    { "waitFor": ".proposed-lane:has-text(\"Export the backlog\")", "timeout": 60000 },
    { "caption": "The proposal is in, and the note folds into Past notes with what it became" },
    { "click": ".notes-past .group-head" },
    { "waitFor": ".note-past:has-text(\"Became\")", "timeout": 30000 },
    { "wait": 2500 },
    { "caption": "" }
  ]
}
