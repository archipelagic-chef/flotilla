{
  "title": "A note's card is a short line that opens its tab, where you answer its agent's question",
  "settings": { "flotilla.agents.maxRunning": 6 },
  "steps": [
    { "click": "[aria-label=\"Backlog\"]" },
    { "click": "[aria-label^=\"New Note\"]" },
    { "waitFor": ".note-page .comment-box textarea" },
    { "wait": 800 },
    { "type": "Tags on tickets, to filter the board fake: ask" },
    { "wait": 600 },
    { "press": "Control+Enter" },
    { "hover": ".notes-lane .group-head" },
    { "waitFor": ".note-card.note-asking", "timeout": 60000 },
    { "hover": ".note-card.note-asking" },
    { "caption": "When a note needs a choice only you can make, its card says its agent asks you" },
    { "wait": 2000 },
    { "caption": "A click anywhere on the card opens the note, with the question to click" },
    { "click": ".note-card.note-asking .note-title" },
    { "waitFor": ".note-page .note-questions .choice:has-text(\"An epic with parts\")" },
    { "wait": 1200 },
    { "click": ".note-page .note-questions .choice:has-text(\"An epic with parts\")" },
    { "wait": 600 },
    { "caption": "Answer sends it, and its chat goes on with it" },
    { "command": "Notifications: Clear All Notifications" },
    { "click": ".note-page button.note-comment" },
    { "command": "Focus on Flotilla View" },
    { "waitFor": ".proposed-lane:has-text(\"Tags on tickets\")", "timeout": 60000 },
    { "caption": "Then it proposes the tickets" },
    { "wait": 2500 },
    { "caption": "" }
  ]
}
