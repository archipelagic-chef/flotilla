{
  "title": "The backlog counts the agents working, with the autopilot off",
  "steps": [
    { "command": "Focus on Flotilla View" },
    { "wait": 2000 },
    { "click": "[aria-label=\"Backlog\"]" },
    { "click": ".backlog-item:has-text(\"Keep the sidebar's scroll on refresh\")" },
    { "caption": "With the autopilot off, sending work back starts its agent" },
    { "click": ".comment-box textarea" },
    { "type": "Test an empty list." },
    { "click": ".actions-row button:has-text(\"Request Changes\")" },
    { "caption": "Under the backlog's title: the agents working, and the limit" },
    { "waitFor": ".agent-count" },
    { "hover": ".agent-count" },
    { "wait": 1500 },
    { "caption": "A click shows what they're doing, with the autopilot's switch" },
    { "click": ".agent-count" },
    { "waitFor": ".autopilot-details" },
    { "wait": 1000 },
    { "caption": "" }
  ]
}
