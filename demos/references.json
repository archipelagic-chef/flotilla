{
  "title": "Refer to another ticket, and find where a ticket is mentioned",
  "steps": [
    { "command": "Focus on Flotilla View" },
    { "click": "[aria-label=\"Backlog\"]" },
    { "wait": 800 },
    { "click": ".backlog-item:has-text(\"Keep chats when a window reloads\") .name" },
    { "waitFor": "h1:has-text(\"Keep chats when a window reloads\")" },
    { "caption": "Typing # (or BL-) in the comment box suggests tickets" },
    { "click": ".comment-box textarea" },
    { "type": "Same order as #sort" },
    { "waitFor": ".md-suggest li.active" },
    { "wait": 1200 },
    { "press": "Enter" },
    { "type": "for the restored chats." },
    { "caption": "The posted comment links the ticket: its hover has the title and status" },
    { "press": "Control+Enter" },
    { "click": ".feed .entry.folded:has-text(\"Same order as\") .entry-fold" },
    { "waitFor": ".feed a.ticket-ref" },
    { "hover": ".feed a.ticket-ref" },
    { "wait": 1500 },
    { "caption": "A click opens it, and its activity says where it's mentioned" },
    { "click": ".feed a.ticket-ref" },
    { "waitFor": "h1:has-text(\"Sort the backlog by priority\")" },
    { "waitFor": ".timeline-item.mention" },
    { "wait": 1500 },
    { "caption": "That line goes back to the comment: it opens and is marked" },
    { "click": ".timeline-item.mention" },
    { "waitFor": ".feed .entry.flash" },
    { "wait": 2500 },
    { "caption": "" }
  ]
}
