{
  "title": "Run a workflow by hand from the CI/CD view",
  "steps": [
    { "click": "[aria-label=\"Version Control\"]" },
    { "click": "[aria-label=\"Version Control: CI/CD\"]" },
    { "waitFor": ".ci .ci-repo" },
    { "caption": "Run Workflow… in the CI/CD view's header" },
    { "click": ".ci .group-head .name" },
    { "click": "[aria-label=\"Run Workflow…\"]" },
    { "caption": "Only workflows with a workflow_dispatch trigger are offered" },
    { "waitFor": ".quick-input-widget .quick-input-list-row:has-text(\"Deploy\")" },
    { "wait": 1200 },
    { "press": "Enter" },
    { "caption": "Then its inputs: a choice is picked from its options" },
    { "waitFor": ".quick-input-widget .quick-input-list-row:has-text(\"production\")" },
    { "wait": 1000 },
    { "type": "production" },
    { "press": "Enter" },
    { "caption": "It confirms: the workflow, the branch, GitHub's commit and the inputs" },
    { "waitFor": ".monaco-dialog-box" },
    { "wait": 2500 },
    { "click": ".monaco-dialog-box .dialog-buttons a:has-text(\"Run\"), .monaco-dialog-box button:has-text(\"Run\")" },
    { "caption": "The new run shows in the view" },
    { "wait": 3000 },
    { "caption": "" }
  ]
}
