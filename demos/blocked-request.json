{
  "title": "A blocked request asks you in Needs you: Allow Once, Always Allow or Keep Blocked",
  "settings": {
    "flotilla.agents.sandbox": "openshell"
  },
  "steps": [
    { "click": "[aria-label=\"Backlog\"]" },
    { "waitFor": ".needs-lane .need-blocked:has-text(\"telemetry.example.com\")" },
    { "caption": "The sandbox blocked a request of BL-3's agent: its ticket asks you in Needs you" },
    { "highlight": ".needs-lane .need-blocked" },
    { "wait": 2500 },
    { "caption": "Who tried to reach what, with which program, and how long it has waited" },
    { "highlight": ".needs-lane .need-blocked .need-line" },
    { "wait": 2500 },
    { "caption": "Allow Once lets only this ticket's sandbox reach it, until the sandbox is removed" },
    { "highlight": ".needs-lane .need-blocked button:has-text(\"Allow Once\")" },
    { "wait": 2000 },
    { "click": ".needs-lane .need-blocked button:has-text(\"Allow Once\")" },
    { "highlight": "" },
    { "waitFor": ".needs-lane .need-blocked:has-text(\"id_rsa\")" },
    { "caption": "The next one is a file: a running sandbox can't take a folder, so it offers Always Allow and Keep Blocked, from the next start" },
    { "highlight": ".needs-lane .need-blocked" },
    { "wait": 3500 },
    { "caption": "Keep Blocked: BL-3 doesn't ask about it again" },
    { "highlight": ".needs-lane .need-blocked button:has-text(\"Keep Blocked\")" },
    { "wait": 2000 },
    { "click": ".needs-lane .need-blocked button:has-text(\"Keep Blocked\")" },
    { "highlight": "" },
    { "waitFor": ".needs-lane .need-blocked:has-text(\"paste.example.org\")" },
    { "caption": "Always Allow would add it to the Security policy, for every sandbox" },
    { "highlight": ".needs-lane .need-blocked button:has-text(\"Always Allow\")" },
    { "wait": 2500 },
    { "highlight": "" },
    { "caption": "Each choice is in the ticket's audit, as yours" },
    { "click": ".backlog-item:has-text(\"Keep chats when a window reloads\") .blocked-mark" },
    { "waitFor": "#audit .audit-table tr:has-text(\"You kept it blocked\")" },
    { "highlight": "#audit .audit-table tr:has-text(\"You allowed it once\")" },
    { "wait": 2500 },
    { "highlight": "#audit .audit-table tr:has-text(\"You kept it blocked\")" },
    { "wait": 2500 },
    { "highlight": "" },
    { "caption": "" }
  ]
}
