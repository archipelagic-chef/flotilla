{
  "title": "Pause and Resume a merge's agent from its ticket, and Pause All while a merge's checks run",
  "settings": {
    "flotilla.merge.checks": "local",
    "flotilla.merge.checkCommand": "npm run checks"
  },
  "steps": [
    { "click": "[aria-label=\"Backlog\"]" },
    { "click": ".backlog-item:has-text(\"Say hi in the greeting\")" },
    { "waitFor": "h1:has-text(\"Say hi in the greeting\")" },
    { "click": ".review-panel button:has-text(\"Approve\")" },
    { "click": ".review-panel button:has-text(\"Merge to main\")" },
    { "waitFor": ".merge-checks" },
    { "caption": "While BL-13's merge checks run, Pause All shows next to the agent count" },
    { "click": ".agent-count-line .pause-all" },
    { "waitFor": ".monaco-dialog-box" },
    { "wait": 2500 },
    { "caption": "It asks first: Let Them Finish (the checks go on), or Stop Them" },
    { "click": ".monaco-dialog-box .monaco-button:has-text(\"Let Them Finish\")" },
    { "waitFor": ".review-panel button:has-text(\"Fix with Agent\")", "timeout": 60000 },
    { "caption": "Resume All" },
    { "click": ".agent-count-line .resume-all" },
    { "caption": "Fix with Agent: an agent works on the merge" },
    { "click": ".review-panel button:has-text(\"Fix with Agent\")" },
    { "waitFor": ".review-panel:has-text(\"is fixing the checks\")" },
    { "wait": 1000 },
    { "caption": "The merge's own Pause: its agent stops, its chat kept" },
    { "click": ".review-panel button:has-text(\"Pause\")" },
    { "waitFor": ".review-panel:has-text(\"is paused\")" },
    { "wait": 2000 },
    { "caption": "Resume: it goes on in its chat, in the merge's worktree" },
    { "click": ".review-panel button:has-text(\"Resume\")" },
    { "waitFor": ".review-panel:has-text(\"is fixing the checks\")" },
    { "wait": 1000 },
    { "caption": "Pause All pauses it too, and Resume All resumes it" },
    { "click": ".agent-count-line .pause-all" },
    { "waitFor": ".review-panel:has-text(\"is paused\")" },
    { "wait": 2000 },
    { "click": ".agent-count-line .resume-all" },
    { "waitFor": ".review-panel:has-text(\"is fixing the checks\")" },
    { "wait": 2000 },
    { "caption": "" }
  ]
}
