{
  "title": "The backlog's Scheduled lane: a row per task with when it runs next and Run Now; a row opens its card and reports",
  "settings": { "flotilla.agents.maxRunning": 4 },
  "steps": [
    { "caption": "Scheduled tasks are a lane of the backlog now, under Discussions: no clock icon in the tool strip" },
    { "click": "[aria-label=\"Backlog\"]" },
    { "waitFor": ".scheduled-lane .scheduled-item:has-text(\"Docs check\")" },
    { "highlight": ".scheduled-lane" },
    { "wait": 2500 },
    { "caption": "One row per task: a proposed one first, with Accept and Dismiss; the others say when they run next, with Run Now" },
    { "highlight": ".scheduled-lane .scheduled-row:has-text(\"Docs check\") .scheduled-actions" },
    { "wait": 2500 },
    { "caption": "A row opens the task's card: its schedule, when it runs next and its reports" },
    { "click": ".scheduled-lane .scheduled-row:has-text(\"Docs check\") .name" },
    { "waitFor": ".scheduled-item:has-text(\"Docs check\") .scheduled-task" },
    { "highlight": ".scheduled-item:has-text(\"Docs check\") .scheduled-task" },
    { "wait": 2500 },
    { "caption": "Run Now starts its agent at once; when it's done, its report is the card's last one" },
    { "click": ".scheduled-row [aria-label=\"Run Docs check now\"]" },
    { "wait": 2000 },
    { "caption": "A report opens as a page, rendered like a ticket's report" },
    { "waitFor": ".scheduled-row:has-text(\"Docs check\") .scheduled-when:has-text(\"in \")", "timeout": 30000 },
    { "highlight": ".scheduled-item:has-text(\"Docs check\") .scheduled-report >> nth=0" },
    { "wait": 1500 },
    { "click": ".scheduled-item:has-text(\"Docs check\") .scheduled-report >> nth=0" },
    { "waitFor": ".page h1:has-text(\"Docs check\")" },
    { "wait": 2500 },
    { "caption": "Back on the board: Accept lets a proposed task run" },
    { "click": "[aria-label=\"Backlog\"]" },
    { "highlight": ".scheduled-row:has-text(\"Test gaps\")" },
    { "wait": 2000 },
    { "click": ".scheduled-row [aria-label=\"Accept Test gaps\"]" },
    { "waitFor": ".scheduled-row:has-text(\"Test gaps\") [aria-label=\"Run Test gaps now\"]" },
    { "highlight": ".scheduled-row:has-text(\"Test gaps\")" },
    { "wait": 2500 },
    { "highlight": "" },
    { "caption": "" }
  ]
}
