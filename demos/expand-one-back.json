{
  "title": "An expanded file has one way back to its ticket, Back to BL-3 at the top of its view; the sidebar's Version Control names the ticket without leading back, and Back switches the sidebar to the Backlog again",
  "settings": { "flotilla.ci.notify": "off", "flotilla.notify": "off" },
  "steps": [
    { "command": "Close All Editor Groups" },
    { "command": "Notifications: Clear All Notifications" },
    { "command": "Focus on Flotilla View" },
    { "click": "[aria-label=\"Backlog\"]" },
    { "wait": 800 },
    { "click": ".backlog-item:has-text(\"Keep chats when a window reloads\")" },
    { "waitFor": "h1:has-text(\"Keep chats when a window reloads\")" },
    { "waitFor": ".change-file:has-text(\"reload.js\")" },
    { "click": ".change-file:has-text(\"reload.js\") .change-unfold" },
    { "waitFor": ".change-hunk .change-action" },
    { "caption": "Expand a file of BL-3's Changes" },
    { "hover": ".change-hunk .change-action" },
    { "wait": 800 },
    { "click": ".change-hunk .change-action" },
    { "waitFor": ".diff-view .diff-view-back" },
    { "caption": "One way back: Back to BL-3. The path beside it only says where you are" },
    { "highlight": ".diff-view-bar" },
    { "wait": 2500 },
    { "caption": "The sidebar follows to BL-3's Changes: the ticket named, no Back button or arrows" },
    { "highlight": ".ticket-vc-head" },
    { "wait": 2500 },
    { "highlight": "" },
    { "caption": "Back to BL-3: the ticket again, and the sidebar on the Backlog" },
    { "hover": ".diff-view-back" },
    { "wait": 800 },
    { "click": ".diff-view-back" },
    { "waitFor": ".backlog-item:has-text(\"Keep chats when a window reloads\")" },
    { "highlight": ".backlog-item:has-text(\"Keep chats when a window reloads\")" },
    { "wait": 2500 },
    { "highlight": "" },
    { "caption": "" }
  ]
}
