{
  "title": "The ticket you're viewing is highlighted in the Backlog, and the Backlog's sub-items in the tool strip show its Changes, Commits and CI under its pinned card",
  "settings": { "flotilla.ci.notify": "off", "flotilla.notify": "off" },
  "steps": [
    { "command": "Close All Editor Groups" },
    { "command": "Notifications: Clear All Notifications" },
    { "command": "Focus on Flotilla View" },
    { "click": "[aria-label=\"Backlog\"]" },
    { "wait": 800 },
    { "click": ".backlog-item:has-text(\"Keep chats when a window reloads\")" },
    { "waitFor": "h1:has-text(\"Keep chats when a window reloads\")" },
    { "waitFor": ".backlog-item.current" },
    { "caption": "BL-3's tab is the active editor: its card is highlighted" },
    { "highlight": ".backlog-item.current" },
    { "wait": 2500 },
    { "caption": "Under the Backlog in the tool strip: BL-3's Changes, Commits and CI" },
    { "highlight": "[aria-label=\"BL-3's Version Control\"]" },
    { "wait": 2500 },
    { "highlight": "" },
    { "hover": "[aria-label=\"Backlog: BL-3's Changes\"]" },
    { "wait": 600 },
    { "click": "[aria-label=\"Backlog: BL-3's Changes\"]" },
    { "waitFor": ".ticket-vc-card .backlog-item" },
    { "waitFor": ".ticket-file:has-text(\"chats.js\")" },
    { "caption": "Still the Backlog: BL-3's card pinned, with its Changes under it; the worktree tabs stay as they were" },
    { "highlight": ".ticket-vc" },
    { "wait": 3000 },
    { "highlight": "" },
    { "caption": "A file opens in VS Code's diff editor" },
    { "click": ".ticket-file:has-text(\"chats.js\")" },
    { "waitFor": ".monaco-diff-editor" },
    { "wait": 2000 },
    { "caption": "Its Commits: the ticket's own, stepped through" },
    { "click": "[aria-label=\"Backlog: BL-3's Commits\"]" },
    { "waitFor": ".commit-step" },
    { "highlight": ".ticket-vc" },
    { "wait": 2500 },
    { "highlight": "" },
    { "caption": "Its CI: the runs of its branch" },
    { "click": "[aria-label=\"Backlog: BL-3's CI\"]" },
    { "wait": 2000 },
    { "caption": "Back to all the tickets, BL-3's card still highlighted" },
    { "click": "[aria-label=\"Backlog: All Tickets\"]" },
    { "waitFor": ".backlog-item.current" },
    { "highlight": ".backlog-item.current" },
    { "wait": 2500 },
    { "highlight": "" },
    { "caption": "" }
  ]
}
