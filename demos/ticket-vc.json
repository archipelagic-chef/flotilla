{
  "title": "From a ticket's Changes to Version Control and back: Open in Version Control lands on the same files; a ticket's commit in History has Open Ticket",
  "settings": { "flotilla.ci.notify": "off", "flotilla.notify": "off" },
  "steps": [
    { "command": "Close All Editor Groups" },
    { "command": "Notifications: Clear All Notifications" },
    { "command": "Focus on Flotilla View" },
    { "click": "[aria-label=\"Backlog\"]" },
    { "wait": 800 },
    { "click": ".backlog-item:has-text(\"Keep chats when a window reloads\")" },
    { "waitFor": "h1:has-text(\"Keep chats when a window reloads\")" },
    { "caption": "1. The ticket's Changes: each file has Open in Version Control" },
    { "hover": ".changes .block-head" },
    { "waitFor": ".change-file:has-text(\"reload.js\")" },
    { "hover": ".change-file:has-text(\"reload.js\")" },
    { "wait": 800 },
    { "hover": ".change-file:has-text(\"reload.js\") [aria-label=\"Open in Version Control\"]" },
    { "wait": 1000 },
    { "click": ".change-file:has-text(\"reload.js\") [aria-label=\"Open in Version Control\"]" },
    { "waitFor": ".ticket-file.selected:has-text(\"reload.js\")" },
    { "caption": "2. Version Control on BL-3's Changes: the same files and counts, reload.js selected" },
    { "hover": ".ticket-file.selected:has-text(\"reload.js\")" },
    { "wait": 2500 },
    { "command": "Close All Editor Groups" },
    { "caption": "3. In History, a ticket's commit has Open Ticket" },
    { "click": "[aria-label=\"Version Control: History\"]" },
    { "waitFor": ".log-row:has-text(\"BL-3:\")" },
    { "click": ".log-row:has-text(\"BL-3:\")" },
    { "waitFor": ".commit-details .open-ticket" },
    { "hover": ".commit-details .open-ticket" },
    { "wait": 1500 },
    { "click": ".commit-details .open-ticket" },
    { "waitFor": "h1:has-text(\"Keep chats when a window reloads\")" },
    { "caption": "Back on the ticket, at its Changes" },
    { "wait": 2500 },
    { "caption": "" }
  ]
}
