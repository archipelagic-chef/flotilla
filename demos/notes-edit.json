{
  "title": "A handled note opens in its note tab, where you edit it, and its agent updates the proposal it became",
  "settings": { "flotilla.agents.maxRunning": 6 },
  "steps": [
    { "command": "Focus on Flotilla View" },
    { "click": "[aria-label=\"Backlog\"]" },
    { "click": "[aria-label^=\"New Note\"]" },
    { "waitFor": ".note-page .comment-box textarea" },
    { "wait": 600 },
    { "type": "Export the backlog as CSV" },
    { "press": "Control+Enter" },
    { "hover": ".notes-lane .group-head" },
    { "waitFor": ".proposed-lane:has-text(\"Export the backlog\")", "timeout": 60000 },
    { "click": ".notes-past .group-head" },
    { "waitFor": ".note-past:has-text(\"Became\")", "timeout": 30000 },
    { "caption": "A note an agent handled can still be changed: Edit opens it in its note tab" },
    { "wait": 1200 },
    { "click": ".note-past:has-text(\"Export the backlog\") .note-edit" },
    { "waitFor": ".note-page .note-entry" },
    { "caption": "What you wrote, to edit, then its activity, and a box to write more" },
    { "wait": 1800 },
    { "click": ".note-page .comment-box textarea" },
    { "press": "Control+End" },
    { "press": "Enter" },
    { "type": "one row per ticket, with its status" },
    { "wait": 600 },
    { "caption": "Save keeps the change as an entry, and opens the note again" },
    { "click": ".note-page button.note-save" },
    { "waitFor": ".note-entry:has-text(\"You edited the note\")" },
    { "wait": 1200 },
    { "caption": "Its agent goes on, and updates the proposal the note became" },
    { "waitFor": ".note-entry:has-text(\"with the note's change\")", "timeout": 60000 },
    { "waitFor": ".note-page .note-tab-status:has-text(\"Handled\")", "timeout": 30000 },
    { "wait": 2500 },
    { "caption": "" }
  ]
}
