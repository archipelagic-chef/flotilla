{
  "title": "Right-click a file of a commit in Version Control › History: Open Changes, Open File, Reveal in Files",
  "settings": { "flotilla.ci.notify": "off", "flotilla.notify": "off" },
  "steps": [
    { "command": "Close All Editor Groups" },
    { "command": "Focus on Flotilla View" },
    { "click": "[aria-label=\"Version Control\"]" },
    { "click": "[aria-label=\"Version Control: History\"]" },
    { "caption": "A commit in History lists the files it changed" },
    { "click": ":nth-match(.log-row, 1)" },
    { "waitFor": ".commit-file" },
    { "wait": 800 },
    { "caption": "A right-click on one: Open Changes, Open File, Reveal in Files" },
    { "rightClick": ":nth-match(.commit-file, 1)" },
    { "waitFor": ".context-view .action-label:has-text(\"Reveal in Files\")" },
    { "wait": 1500 },
    { "click": ".context-view .action-label:has-text(\"Reveal in Files\")" },
    { "caption": "Flotilla's Files selects it, its folders expanded" },
    { "waitFor": ".row.file.selected" },
    { "wait": 2500 },
    { "caption": "Back in History, Open Changes opens that file's diff in the commit, as a click on the row does" },
    { "click": "[aria-label=\"Version Control\"]" },
    { "click": "[aria-label=\"Version Control: History\"]" },
    { "click": ":nth-match(.log-row, 1)" },
    { "waitFor": ".commit-file" },
    { "rightClick": ":nth-match(.commit-file, 1)" },
    { "waitFor": ".context-view .action-label:has-text(\"Open Changes\")" },
    { "wait": 800 },
    { "click": ".context-view .action-label:has-text(\"Open Changes\")" },
    { "waitFor": ".monaco-diff-editor" },
    { "wait": 2500 },
    { "caption": "" }
  ]
}
