{
  "title": "Flotilla Settings: the gear at the top of the sidebar opens all of Flotilla's settings, in six groups",
  "steps": [
    { "command": "Focus on Flotilla View" },
    { "hover": ".part.sidebar .composite.title" },
    { "waitFor": "[aria-label=\"Flotilla Settings…\"]" },
    { "highlight": "[aria-label=\"Flotilla Settings…\"]" },
    { "caption": "New at the top of the Flotilla sidebar: the gear, Flotilla Settings…" },
    { "wait": 1500 },
    { "highlight": "" },
    { "click": "[aria-label=\"Flotilla Settings…\"]" },
    { "waitFor": ".settings-toc-container .monaco-list-row:has-text(\"Review & Merge\")", "timeout": 15000 },
    { "highlight": ".settings-toc-container" },
    { "caption": "VS Code's Settings, on the Workspace tab, filtered to Flotilla: its settings in six groups" },
    { "wait": 2500 },
    { "highlight": "" },
    { "click": ".settings-toc-container .monaco-list-row:has-text(\"Autopilot\")" },
    { "waitFor": ".setting-item-contents:has-text(\"Max Running\")" },
    { "caption": "Autopilot: when agents start To Do tickets on their own, and how many at once" },
    { "highlight": ".setting-item-contents:has-text(\"Max Running\")" },
    { "wait": 2000 },
    { "highlight": "" },
    { "click": ".settings-toc-container .monaco-list-row:has-text(\"Backlog & Tickets\")" },
    { "waitFor": ".setting-item-contents:has-text(\"Id Prefix\") a:has-text(\"Backlog Integrations\")" },
    { "highlight": ".setting-item-contents:has-text(\"Id Prefix\") a:has-text(\"Backlog Integrations\")" },
    { "caption": "Integrations (Jira, GitHub Issues) are a click away from the backlog's settings" },
    { "wait": 1500 },
    { "highlight": "" },
    { "click": ".setting-item-contents:has-text(\"Id Prefix\") a:has-text(\"Backlog Integrations\")" },
    { "waitFor": ".quick-input-widget" },
    { "caption": "Backlog Integrations: connect Jira or GitHub Issues" },
    { "wait": 2500 },
    { "press": "Escape" },
    { "caption": "" }
  ]
}
