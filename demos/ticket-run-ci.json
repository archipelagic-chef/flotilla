{
  "title": "Run a ticket's CI from the ticket: push its branch, then run a workflow by hand on it",
  "runsOnPush": true,
  "steps": [
    { "click": "[aria-label=\"Backlog\"]" },
    { "click": ".backlog-item:has-text(\"Keep chats when a window reloads\") .name" },
    { "waitFor": "h1:has-text(\"Keep chats when a window reloads\")" },
    { "caption": "Its branch isn't on origin yet: the ticket's CI line says so, with Run CI" },
    { "waitFor": ".ci-panel .ci-line.none:has-text(\"Not on origin yet\")" },
    { "wait": 2000 },
    { "caption": "Run CI pushes the branch, with the push's checks: the workflows that run on push start" },
    { "click": ".ci-panel .ci-run" },
    { "waitFor": ".ci-panel .ci-line.queued, .ci-panel .ci-line.running", "timeout": 30000 },
    { "wait": 2500 },
    { "caption": "Run Workflow… starts one that runs by hand, on the ticket's branch" },
    { "click": ".ci-panel [aria-label=\"Run Workflow…\"]" },
    { "waitFor": ".quick-input-widget .quick-input-list-row:has-text(\"Deploy\")" },
    { "wait": 1000 },
    { "press": "Enter" },
    { "caption": "With its inputs" },
    { "waitFor": ".quick-input-widget .quick-input-list-row:has-text(\"production\")" },
    { "wait": 1000 },
    { "type": "production" },
    { "press": "Enter" },
    { "waitFor": ".monaco-dialog-box" },
    { "wait": 2000 },
    { "click": ".monaco-dialog-box .dialog-buttons a:has-text(\"Run\"), .monaco-dialog-box button:has-text(\"Run\")" },
    { "caption": "Both runs show in the ticket's CI once GitHub lists them" },
    { "click": ".ci-panel .ci-summary" },
    { "waitFor": ".ci-runs .row:has-text(\"Deploy\")", "timeout": 20000 },
    { "wait": 3000 },
    { "click": ".ci-panel .ci-summary" },
    { "caption": "" }
  ]
}
