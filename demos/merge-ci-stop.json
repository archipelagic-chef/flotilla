{
  "title": "Merge to main stopped on red CI says why under its button: the failed job, its log, and Fix with Agent",
  "steps": [
    { "command": "Focus on Flotilla View" },
    { "click": "[aria-label=\"Backlog\"]" },
    { "click": ".backlog-item:has-text(\"Say hi in the greeting\") .name" },
    { "waitFor": "h1:has-text(\"Say hi in the greeting\")" },
    { "caption": "CI runs on BL-13's pushed branch, and fails" },
    { "waitFor": ".ci-panel .ci-line.failure", "timeout": 60000 },
    { "caption": "" },
    { "click": ".review-panel button:has-text(\"Approve\")" },
    { "click": ".review-panel button:has-text(\"Merge to main\")" },
    { "caption": "Nothing is merged, and the ticket says why next to the button" },
    { "waitFor": ".merge-stop", "timeout": 30000 },
    { "hover": ".merge-stop button:has-text(\"Fix with Agent\")" },
    { "wait": 3000 },
    { "caption": "" }
  ]
}
